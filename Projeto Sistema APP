        <table className="w-full text-sm">
          <thead>
            <tr style={{ background: C.panelAlt }}>
              {["Fatura", "Cliente", "Vencimento", "Valor", "Status"].map(h => (
                <th key={h} className="text-left px-4 py-2.5 text-xs font-medium" style={{ color: C.faint, ...fontBody }}>{h}</th>
              ))}
            </tr>
          </thead>
          <tbody>
            {[
              { f: "#3021", c: "Restaurante Sabor Real", v: "08/09/2026", val: "R$ 1.240,00", st: "atrasado" },
              { f: "#3020", c: "Farmácia Bem Estar", v: "05/09/2026", val: "R$ 890,00", st: "entregue" },
              { f: "#3019", c: "Mercado Vila Nova", v: "01/09/2026", val: "R$ 2.100,00", st: "entregue" },
            ].map((r, i) => (
              <tr key={r.f} style={{ background: C.panel, borderTop: i > 0 ? `1px solid ${C.line}` : "none" }}>
                <td className="px-4 py-3 font-medium" style={{ color: C.text, ...fontBody }}>{r.f}</td>
                <td className="px-4 py-3" style={{ color: C.text, ...fontBody }}>{r.c}</td>
                <td className="px-4 py-3" style={{ color: C.muted, ...fontBody }}>{r.v}</td>
                <td className="px-4 py-3" style={{ color: C.text, ...fontBody }}>{r.val}</td>
                <td className="px-4 py-3">
                  <Pill status={r.st === "entregue" ? "entregue" : "atrasado"} />
                </td>
