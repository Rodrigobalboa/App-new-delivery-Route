function formatarMoeda(valor) {
  return `R$ ${Number(valor).toFixed(2).replace(".", ",")}`;
}

function formatarHora(iso) {
  try {
    const d = new Date(iso);
    return `${String(d.getHours()).padStart(2, "0")}:${String(d.getMinutes()).padStart(2, "0")}`;
  } catch (e) {
    return "—";
  }
}

function mapPedidoApi(p) {
  return {
    _dbId: p.id,
    id: p.codigo,
    cliente: p.clienteNome,
    endereco: p.endereco,
    entregador: p.entregador ? p.entregador.nomeCompleto : "—",
    entregadorId: p.entregador ? p.entregador.id : null,
    comercio: p.comercio ? p.comercio.nomeFantasia : "—",
    status: (p.status || "PREPARANDO").toLowerCase(),
    valor: p.valor != null ? formatarMoeda(p.valor) : "—",
    eta: p.prazoDesejado || "—",
    observacao: p.observacao || "",
  };
}

function PedidosView() {
  const { token } = useAuth();
  const [pedidos, setPedidos] = useState([]);
  const [entregadoresApi, setEntregadoresApi] = useState([]);
  const [carregando, setCarregando] = useState(true);
  const [erroCarregar, setErroCarregar] = useState("");
  const [filtro, setFiltro] = useState("todos");
  const [busca, setBusca] = useState("");
  const [visao, setVisao] = useState("lista");
  const [menuAberto, setMenuAberto] = useState(null);
  const [menuPos, setMenuPos] = useState({ x: 0, y: 0 });
  const [modal, setModal] = useState(null);
  const [logsModal, setLogsModal] = useState([]);
  const [obsRascunho, setObsRascunho] = useState("");
  const [feedback, setFeedback] = useState("");

  const showFeedback = (msg) => { setFeedback(msg); setTimeout(() => setFeedback(""), 2800); };

  const carregarPedidos = () => {
    apiFetch("/pedidos", { token })
      .then(data => { setPedidos(data.map(mapPedidoApi)); setErroCarregar(""); })
      .catch(err => setErroCarregar(err.message))
      .finally(() => setCarregando(false));
  };

  useEffect(() => {
    carregarPedidos();
    apiFetch("/entregadores", { token }).then(setEntregadoresApi).catch(() => {});
  }, []);

  const filtrados = pedidos.filter(p =>
    (filtro === "todos" || p.status === filtro) &&
    (p.cliente.toLowerCase().includes(busca.toLowerCase()) || p.id.toLowerCase().includes(busca.toLowerCase()))
  );
  const contagem = (st) => pedidos.filter(p => st === "todos" ? true : p.status === st).length;

  const handlePedidoPronto = async (pedido) => {
    try {
      await apiFetch(`/pedidos/${pedido._dbId}/pronto`, { token, method: "PATCH" });
      showFeedback(`Pedido ${pedido.id} liberado — agora visível para os entregadores.`);
      carregarPedidos();
    } catch (err) {
      showFeedback(err.message || "Não foi possível liberar o pedido.");
    }
  };

  const abrirMenu = (id, evt) => {
    if (id === null) { setMenuAberto(null); return; }
    const rect = evt.currentTarget.getBoundingClientRect();
    setMenuPos({ x: rect.right - 232, y: rect.bottom + 6 });
    setMenuAberto(menuAberto === id ? null : id);
  };

  const handleAcao = async (pedido, acao) => {
    setMenuAberto(null);
    try {
      switch (acao.id) {
        case "editar":
          showFeedback(`Edição completa ainda não tem tela dedicada — use "Detalhes" por enquanto.`);
          break;
        case "detalhes":
          setModal({ tipo: "detalhes", pedido });
          break;
        case "finalizar":
          await apiFetch(`/pedidos/${pedido._dbId}/finalizar`, { token, method: "PATCH" });
          showFeedback(`Pedido ${pedido.id} finalizado com sucesso.`);
          carregarPedidos();
          break;
        case "copiar_link": {
          const url = `https://track.routedelivery.com/${pedido.id}`;
          if (navigator.clipboard) navigator.clipboard.writeText(url).catch(() => {});
          showFeedback(`Link de rastreio copiado: ${url}`);
          break;
        }
        case "logs": {
          const logs = await apiFetch(`/pedidos/${pedido._dbId}/logs`, { token });
          setLogsModal(logs);
          setModal({ tipo: "logs", pedido });
          break;
        }
        case "clonar": {
          const clone = await apiFetch(`/pedidos/${pedido._dbId}/clonar`, { token, method: "POST" });
          showFeedback(`Pedido clonado como ${clone.codigo}.`);
          carregarPedidos();
          break;
        }
        case "observacao":
          setObsRascunho(pedido.observacao || "");
          setModal({ tipo: "observacao", pedido });
          break;
        case "editar_comercio":
          showFeedback(`Abra Cadastro > Comércio para editar "${pedido.comercio}".`);
          break;
        case "editar_entregador":
          showFeedback(`Abra Cadastro > Entregadores para editar "${pedido.entregador}".`);
          break;
        case "bloquear_entregador":
          if (pedido.entregadorId) {
            await apiFetch(`/entregadores/${pedido.entregadorId}/bloquear`, { token, method: "PATCH" });
            apiFetch("/entregadores", { token }).then(setEntregadoresApi).catch(() => {});
          }
          showFeedback(`${pedido.entregador} foi bloqueado para novos pedidos.`);
          break;
        case "trocar_entregador":
          setModal({ tipo: "trocarEntregador", pedido });
          break;
        case "reprocurar":
          await apiFetch(`/pedidos/${pedido._dbId}/reprocurar`, { token, method: "PATCH" });
          showFeedback(`Buscando novo entregador para o pedido ${pedido.id}.`);
          carregarPedidos();
          break;
        case "cancelar":
          await apiFetch(`/pedidos/${pedido._dbId}/cancelar`, { token, method: "PATCH" });
          showFeedback(`Entrega ${pedido.id} cancelada.`);
          carregarPedidos();
          break;
        default:
          break;
      }
    } catch (err) {
      showFeedback(err.message || "Não foi possível concluir a ação.");
    }
  };

  const salvarObservacao = async () => {
    if (!modal) return;
    try {
      await apiFetch(`/pedidos/${modal.pedido._dbId}/observacao`, { token, method: "POST", body: { texto: obsRascunho } });
      showFeedback(`Observação salva no pedido ${modal.pedido.id}.`);
      setModal(null);
      carregarPedidos();
    } catch (err) {
      showFeedback(err.message || "Não foi possível salvar a observação.");
    }
  };

  const trocarEntregador = async (entregador) => {
    if (!modal) return;
    try {
      await apiFetch(`/pedidos/${modal.pedido._dbId}/trocar-entregador`, { token, method: "PATCH", body: { entregadorId: entregador.id } });
      showFeedback(`Entregador do pedido ${modal.pedido.id} trocado para ${entregador.nomeCompleto}.`);
      setModal(null);
      carregarPedidos();
    } catch (err) {
      showFeedback(err.message || "Não foi possível trocar o entregador.");
    }
  };

  return (
    <div>
      <SectionHeader
        title="Acompanhamento de Pedidos"
        subtitle="Status em tempo real de todas as entregas de hoje"
        action={
          <div className="flex gap-1.5">
            {[{ id: "lista", label: "Lista" }, { id: "mapa", label: "Mapa" }].map(v => (
              <button
                key={v.id}
                onClick={() => setVisao(v.id)}
                className="px-3.5 py-1.5 rounded-sm text-xs font-medium"
                style={{
                  background: visao === v.id ? C.amber : "transparent",
                  color: visao === v.id ? C.ink : C.muted,
                  border: `1px solid ${visao === v.id ? C.amber : C.line}`,
                  ...fontBody,
                }}
              >
                {v.label}
              </button>
            ))}
          </div>
        }
      />

      {feedback && (
        <div className="flex items-center gap-2 rounded-sm px-4 py-2.5 mb-4 text-sm" style={{ background: C.greenDim, color: C.green, ...fontBody }}>
          <CheckCircle2 size={14} /> {feedback}
        </div>
      )}
      {erroCarregar && (
        <div className="flex items-center gap-2 rounded-sm px-4 py-2.5 mb-4 text-sm" style={{ background: C.redDim, color: C.red, ...fontBody }}>
          <AlertTriangle size={14} /> Não foi possível carregar os pedidos do backend ({erroCarregar}). Verifique se a API está rodando em {API_BASE_URL}.
        </div>
      )}

      <MapaTempoReal />

      <div className="flex gap-3 mb-5">
        <StatCard label="Preparando" value={contagem("preparando")} icon={ClipboardList} />
        <StatCard label="Em rota" value={contagem("em_rota")} icon={Truck} />
        <StatCard label="Entregues" value={contagem("entregue")} delta="+6 na última hora" deltaGood icon={CheckCircle2} />
        <StatCard label="Pendentes" value={contagem("pendente")} icon={Clock} />
        <StatCard label="Atrasados" value={contagem("atrasado")} delta="requer atenção" icon={AlertTriangle} />
      </div>

      {visao === "mapa" ? (
        <MapaAcompanhamento />
      ) : (
        <>
          <div className="flex items-center gap-3 mb-4">
            <div className="flex items-center gap-2 px-3 py-2 rounded-sm flex-1 max-w-xs" style={{ background: C.panel, border: `1px solid ${C.line}` }}>
              <Search size={14} style={{ color: C.faint }} />
              <input
                value={busca}
                onChange={e => setBusca(e.target.value)}
                placeholder="Buscar por cliente ou nº do pedido"
                className="bg-transparent outline-none text-sm w-full"
                style={{ color: C.text, ...fontBody }}
              />
            </div>
            <div className="flex gap-1.5">
              {["todos", "preparando", "pendente", "em_rota", "entregue", "atrasado", "cancelado"].map(st => (
                <button
                  key={st}
                  onClick={() => setFiltro(st)}
                  className="px-3 py-2 rounded-sm text-xs font-medium transition-colors"
                  style={{
                    background: filtro === st ? C.amber : "transparent",
                    color: filtro === st ? C.ink : C.muted,
                    border: `1px solid ${filtro === st ? C.amber : C.line}`,
                    ...fontBody,
                  }}
                >
                  {st === "todos" ? "Todos" : STATUS_MAP[st].label}
                </button>
              ))}
            </div>
          </div>

          {carregando ? (
            <p className="text-sm py-6 text-center" style={{ color: C.faint, ...fontBody }}>Carregando pedidos...</p>
          ) : (
            <div className="rounded-sm overflow-visible" style={{ border: `1px solid ${C.line}` }}>
              <table className="w-full text-sm">
                <thead>
                  <tr style={{ background: C.panelAlt, ...fontBody }}>
                    {["Pedido", "Cliente", "Endereço", "Entregador", "Status", "Valor", "ETA", "Ações"].map(h => (
                      <th key={h} className="text-left px-4 py-2.5 text-xs font-medium" style={{ color: C.faint }}>{h}</th>
                    ))}
                  </tr>
                </thead>
                <tbody>
                  {filtrados.map((p, i) => (
                    <tr key={p.id} style={{ background: C.panel, borderTop: i > 0 ? `1px solid ${C.line}` : "none" }}>
                      <td className="px-4 py-3 font-medium" style={{ color: C.text, ...fontBody }}>{p.id}</td>
                      <td className="px-4 py-3" style={{ color: C.text, ...fontBody }}>{p.cliente}</td>
                      <td className="px-4 py-3 flex items-center gap-1.5" style={{ color: C.muted, ...fontBody }}>
                        <MapPin size={13} style={{ color: C.faint }} />{p.endereco}
                      </td>
                      <td className="px-4 py-3" style={{ color: C.muted, ...fontBody }}>{p.entregador}</td>
                      <td className="px-4 py-3"><Pill status={p.status} /></td>
                      <td className="px-4 py-3">
                        <div className="flex items-center gap-2">
                          <span style={{ color: C.text, ...fontBody }}>{p.valor}</span>
                          {p.status === "preparando" && (
                            <button
                              onClick={() => handlePedidoPronto(p)}
                              className="px-2.5 py-1 rounded-sm text-xs font-medium whitespace-nowrap"
                              style={{ background: C.purple, color: C.ink, ...fontBody }}
                            >
                              Pedido Pronto
                            </button>
                          )}
                        </div>
                      </td>
                      <td className="px-4 py-3" style={{ color: C.muted, ...fontBody }}>{p.eta}</td>
                      <td className="px-4 py-3">
                        <OrderActionsMenu
                          pedido={p}
                          acoes={getAcoesPedido(p)}
                          aberto={menuAberto === p.id}
                          posicao={menuPos}
                          onAbrir={(id, e) => abrirMenu(id, e)}
                          onAcao={handleAcao}
                        />
                      </td>
                    </tr>
                  ))}
                  {filtrados.length === 0 && (
                    <tr style={{ background: C.panel }}>
                      <td colSpan={8} className="px-4 py-8 text-center text-sm" style={{ color: C.faint, ...fontBody }}>
                        Nenhum pedido encontrado para esse filtro.
                      </td>
                    </tr>
                  )}
                </tbody>
              </table>
            </div>
          )}
          <p className="text-xs mt-3" style={{ color: C.faint, ...fontBody }}>
            Pedidos em "Preparando" só ficam visíveis para entregadores depois que o comércio clica em "Pedido Pronto". Dados vindos do backend em {API_BASE_URL}.
          </p>
        </>
      )}

      {modal && (
        <div className="fixed inset-0 flex items-center justify-center px-4" style={{ background: "rgba(0,0,0,0.6)", zIndex: 70 }} onClick={() => setModal(null)}>
          <div className="rounded-sm p-5 w-full max-w-md" style={{ background: C.panel, border: `1px solid ${C.line}` }} onClick={e => e.stopPropagation()}>
            <div className="flex items-center justify-between mb-4">
              <span className="text-sm font-semibold" style={{ color: C.text, ...fontHead }}>
                {modal.tipo === "detalhes" && `Detalhes — ${modal.pedido.id}`}
                {modal.tipo === "logs" && `Logs — ${modal.pedido.id}`}
                {modal.tipo === "observacao" && `Observação — ${modal.pedido.id}`}
                {modal.tipo === "trocarEntregador" && `Trocar entregador — ${modal.pedido.id}`}
              </span>
              <button onClick={() => setModal(null)} style={{ color: C.faint }}><X size={16} /></button>
            </div>

            {modal.tipo === "detalhes" && (
              <div className="flex flex-col gap-3 text-sm" style={{ ...fontBody }}>
                <div><span className="block text-xs mb-0.5" style={{ color: C.faint }}>Cliente</span><span style={{ color: C.text }}>{modal.pedido.cliente}</span></div>
                <div><span className="block text-xs mb-0.5" style={{ color: C.faint }}>Comércio</span><span style={{ color: C.text }}>{modal.pedido.comercio}</span></div>
                <div><span className="block text-xs mb-0.5" style={{ color: C.faint }}>Endereço</span><span style={{ color: C.text }}>{modal.pedido.endereco}</span></div>
                <div><span className="block text-xs mb-0.5" style={{ color: C.faint }}>Entregador</span><span style={{ color: C.text }}>{modal.pedido.entregador}</span></div>
                <div><span className="block text-xs mb-0.5" style={{ color: C.faint }}>Status</span><Pill status={modal.pedido.status} /></div>
                <div className="flex gap-6">
                  <div><span className="block text-xs mb-0.5" style={{ color: C.faint }}>Valor</span><span style={{ color: C.text }}>{modal.pedido.valor}</span></div>
                  <div><span className="block text-xs mb-0.5" style={{ color: C.faint }}>ETA</span><span style={{ color: C.text }}>{modal.pedido.eta}</span></div>
                </div>
                {modal.pedido.observacao && (
                  <div className="pt-2" style={{ borderTop: `1px solid ${C.line}` }}>
                    <span className="block text-xs mb-0.5" style={{ color: C.faint }}>Observação</span>
                    <span style={{ color: C.text }}>{modal.pedido.observacao}</span>
                  </div>
                )}
              </div>
            )}

            {modal.tipo === "logs" && (
              <div className="flex flex-col gap-2">
                {logsModal.map((l) => (
                  <div key={l.id} className="flex gap-3 text-sm px-3 py-2 rounded-sm" style={{ background: C.panelAlt, ...fontBody }}>
                    <span style={{ color: C.faint }}>{formatarHora(l.createdAt)}</span>
                    <span style={{ color: C.text }}>{l.texto}</span>
                  </div>
                ))}
                {logsModal.length === 0 && (
                  <p className="text-sm" style={{ color: C.faint, ...fontBody }}>Nenhum evento registrado ainda.</p>
                )}
              </div>
            )}

            {modal.tipo === "observacao" && (
              <div>
                <textarea
                  rows={4}
                  value={obsRascunho}
                  onChange={e => setObsRascunho(e.target.value)}
                  placeholder="Escreva uma observação sobre este pedido..."
                  className="w-full px-3 py-2.5 rounded-sm text-sm outline-none resize-none mb-3"
                  style={{ background: C.panelAlt, border: `1px solid ${C.line}`, color: C.text, ...fontBody }}
                />
                <button onClick={salvarObservacao} className="px-4 py-2 rounded-sm text-sm font-medium" style={{ background: C.amber, color: C.ink, ...fontBody }}>
                  Salvar observação
                </button>
              </div>
            )}

            {modal.tipo === "trocarEntregador" && (
              <div className="flex flex-col gap-1.5">
                {entregadoresApi
                  .filter(e => e.id !== modal.pedido.entregadorId && !e.bloqueado)
                  .map(e => (
                    <button
                      key={e.id}
                      onClick={() => trocarEntregador(e)}
                      className="w-full text-left px-3 py-2.5 rounded-sm text-sm"
                      style={{ background: C.panelAlt, border: `1px solid ${C.line}`, color: C.text, ...fontBody }}
                    >
                      {e.nomeCompleto}
                    </button>
                  ))}
                {entregadoresApi.filter(e => e.id !== modal.pedido.entregadorId && !e.bloqueado).length === 0 && (
                  <p className="text-sm" style={{ color: C.faint, ...fontBody }}>Nenhum outro entregador disponível no cadastro.</p>
                )}
              </div>
            )}
          </div>
        </div>
      )}
    </div>
  );
}

function NovaEntregaView() {
  const { token } = useAuth();
  const [comercios, setComercios] = useState([]);
  const [entregadoresApi, setEntregadoresApi] = useState([]);
  const [enviado, setEnviado] = useState(false);
  const [ultimoPedido, setUltimoPedido] = useState(null);
  const [comercioSelecionado, setComercioSelecionado] = useState("");
  const [nomeCliente, setNomeCliente] = useState("");
  const [telefone, setTelefone] = useState("");
  const [endereco, setEndereco] = useState("");
  const [pontoReferencia, setPontoReferencia] = useState("");
  const [prazoDesejado, setPrazoDesejado] = useState("");
  const [entregadorEscolhido, setEntregadorEscolhido] = useState("");
  const [formaPagamento, setFormaPagamento] = useState("Pix");
  const [erroValidacao, setErroValidacao] = useState("");
  const [enviando, setEnviando] = useState(false);
  const [calculando, setCalculando] = useState(false);
  const [distanciaKm, setDistanciaKm] = useState(null);
  const [valorCalculado, setValorCalculado] = useState(null);
  const [erroCalculo, setErroCalculo] = useState("");

  useEffect(() => {
    apiFetch("/comercios", { token }).then(setComercios).catch(() => {});
    apiFetch("/entregadores", { token }).then(setEntregadoresApi).catch(() => {});
  }, []);

  useEffect(() => {
    setDistanciaKm(null);
    setValorCalculado(null);
    setErroCalculo("");

    if (!comercioSelecionado || !endereco || endereco.trim().length < 6) return;

    setCalculando(true);
    const timer = setTimeout(async () => {
      try {
        const resultado = await apiFetch("/nova-entrega/calcular", {
          token, method: "POST", body: { comercioId: comercioSelecionado, endereco },
        });
        setDistanciaKm(resultado.distanciaKm);
        setValorCalculado(resultado.valor);
      } catch (err) {
        setErroCalculo(err.message || "Não foi possível calcular a rota até esse endereço.");
      } finally {
        setCalculando(false);
      }
    }, 900);

    return () => clearTimeout(timer);
  }, [comercioSelecionado, endereco]);

  const handleCriarEntrega = async () => {
    setErroValidacao("");
    if (!comercioSelecionado) { setErroValidacao('Selecione o "Comércio de origem".'); return; }
    if (!nomeCliente.trim()) { setErroValidacao('Informe o "Nome do cliente".'); return; }
    if (!endereco.trim()) { setErroValidacao('Informe o "Endereço de entrega".'); return; }

    setEnviando(true);
    try {
      const comercioNome = (comercios.find(c => c.id === comercioSelecionado) || {}).nomeFantasia || "";
      const pedido = await apiFetch("/nova-entrega", {
        token, method: "POST",
        body: {
          comercioId: comercioSelecionado,
          clienteNome: nomeCliente,
          clienteTelefone: telefone,
          endereco,
          prazoDesejado,
          formaPagamento,
          entregadorId: entregadorEscolhido || null,
        },
      });
      setUltimoPedido({
        id: pedido.codigo,
        cliente: nomeCliente,
        comercio: comercioNome,
        endereco,
        distancia: pedido.distanciaKm != null ? `${pedido.distanciaKm.toFixed(1)} km` : "distância não calculada",
        valor: pedido.valor != null ? formatarMoeda(pedido.valor) : "a combinar",
      });
      setEnviado(true);
      setComercioSelecionado(""); setNomeCliente(""); setTelefone(""); setEndereco("");
      setPontoReferencia(""); setPrazoDesejado("");
      setEntregadorEscolhido(""); setFormaPagamento("Pix");
      setDistanciaKm(null); setValorCalculado(null); setErroCalculo("");
    } catch (err) {
      setErroValidacao(err.message || "Não foi possível criar a entrega.");
    } finally {
      setEnviando(false);
    }
  };

  return (
    <div>
      <SectionHeader title="Nova entrega" subtitle="Cadastre um novo pedido para despacho" />
      {enviado && ultimoPedido && (
        <div className="flex items-center gap-2 rounded-sm px-4 py-3 mb-5 text-sm" style={{ background: C.greenDim, color: C.green, ...fontBody }}>
          <CheckCircle2 size={16} />
          Entrega {ultimoPedido.id} criada para {ultimoPedido.cliente} ({ultimoPedido.comercio} → {ultimoPedido.endereco}) — {ultimoPedido.distancia}, {ultimoPedido.valor}. Enviada para a fila de despacho.
        </div>
      )}
      {erroValidacao && (
        <div className="flex items-center gap-2 rounded-sm px-4 py-3 mb-5 text-sm" style={{ background: C.redDim, color: C.red, ...fontBody }}>
          <AlertTriangle size={16} /> {erroValidacao}
        </div>
      )}

      <div className="grid grid-cols-2 gap-4 max-w-3xl mb-2">
        <Field label="Comércio de origem">
          <div className="relative">
            <select
              value={comercioSelecionado}
              onChange={e => setComercioSelecionado(e.target.value)}
              className="w-full px-3 py-2.5 rounded-sm text-sm outline-none appearance-none"
              style={{ background: C.panel, border: `1px solid ${C.line}`, color: C.text, ...fontBody }}
            >
              <option value="">Selecione...</option>
              {comercios.map(c => <option key={c.id} value={c.id}>{c.nomeFantasia}</option>)}
            </select>
            <ChevronDown size={14} className="absolute right-3 top-3 pointer-events-none" style={{ color: C.faint }} />
          </div>
        </Field>
        <Field label="Nome do cliente"><TextInput placeholder="Ex: Marcela Ito" value={nomeCliente} onChange={e => setNomeCliente(e.target.value)} /></Field>
        <Field label="Telefone"><TextInput placeholder="(11) 90000-0000" value={telefone} onChange={e => setTelefone(e.target.value)} /></Field>
        <div className="col-span-2">
          <Field label="Endereço de entrega">
            <TextInput
              placeholder="Rua, número, bairro"
              value={endereco}
              onChange={e => setEndereco(e.target.value)}
            />
          </Field>
        </div>
      </div>

      <div className="max-w-3xl mb-6">
        {comercios.length === 0 && (
          <p className="text-xs" style={{ color: C.faint, ...fontBody }}>
            Nenhum comércio carregado do backend ainda — cadastre um em Cadastro &gt; Comércio, com endereço e coordenadas.
          </p>
        )}
        {!comercioSelecionado && endereco.trim().length >= 6 && comercios.length > 0 && (
          <p className="text-xs" style={{ color: C.faint, ...fontBody }}>Selecione o comércio de origem para calcular a distância e a taxa.</p>
        )}
        {calculando && (
          <p className="text-xs" style={{ color: C.faint, ...fontBody }}>Calculando rota até o endereço informado...</p>
        )}
        {erroCalculo && (
          <p className="text-xs" style={{ color: C.red, ...fontBody }}>{erroCalculo}</p>
        )}
        {!calculando && distanciaKm !== null && valorCalculado !== null && (
          <div className="flex gap-6 rounded-sm px-4 py-3" style={{ background: C.panel, border: `1px solid ${C.line}` }}>
            <div>
              <span className="block text-xs mb-0.5" style={{ color: C.faint, ...fontBody }}>Distância pelo percurso</span>
              <span className="text-sm font-semibold" style={{ color: C.text, ...fontHead }}>{distanciaKm.toFixed(1)} km</span>
            </div>
            <div>
              <span className="block text-xs mb-0.5" style={{ color: C.faint, ...fontBody }}>Taxa calculada</span>
              <span className="text-sm font-semibold" style={{ color: C.amber, ...fontHead }}>{formatarMoeda(valorCalculado)}</span>
            </div>
            <p className="text-xs self-end pb-0.5" style={{ color: C.faint, ...fontBody }}>
              Calculado pelo backend, via rota real (não em linha reta).
            </p>
          </div>
        )}
      </div>

      <div className="grid grid-cols-2 gap-4 max-w-3xl">
        <div>
          <label className="block text-xs font-medium mb-1.5" style={{ color: C.muted, ...fontBody }}>Ponto de referência</label>
          <input
            placeholder="Opcional"
            value={pontoReferencia}
            onChange={e => setPontoReferencia(e.target.value)}
            className="w-full px-3 py-2.5 rounded-sm text-sm outline-none"
            style={{ background: C.panel, border: `1px solid ${C.line}`, color: C.text, ...fontBody }}
          />
        </div>
        <div>
          <label className="block text-xs font-medium mb-1.5" style={{ color: C.muted, ...fontBody }}>
            Valor do pedido {valorCalculado !== null && <span style={{ color: C.faint }}>(preenchido automaticamente)</span>}
          </label>
          <input
            placeholder="R$ 0,00"
            value={valorCalculado !== null ? formatarMoeda(valorCalculado) : ""}
            readOnly={valorCalculado !== null}
            className="w-full px-3 py-2.5 rounded-sm text-sm outline-none"
            style={{ background: C.panel, border: `1px solid ${C.line}`, color: C.text, ...fontBody }}
          />
        </div>
        <div>
          <label className="block text-xs font-medium mb-1.5" style={{ color: C.muted, ...fontBody }}>Prazo desejado</label>
          <input
            placeholder="Hoje até 19:00"
            value={prazoDesejado}
            onChange={e => setPrazoDesejado(e.target.value)}
            className="w-full px-3 py-2.5 rounded-sm text-sm outline-none"
            style={{ background: C.panel, border: `1px solid ${C.line}`, color: C.text, ...fontBody }}
          />
        </div>
        <div>
