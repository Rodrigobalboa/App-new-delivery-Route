async function geocodificarEnderecoSimples(endereco) {
  try {
    const query = encodeURIComponent(
      `${endereco.rua || ""}, ${endereco.numero || ""}, ${endereco.bairro || ""}, ${endereco.cidade || "São Paulo"}, Brasil`
    );
    const resp = await fetch(`https://nominatim.openstreetmap.org/search?format=json&limit=1&q=${query}`);
    const data = await resp.json();
    if (data && data.length > 0) {
      return { lat: parseFloat(data[0].lat), lng: parseFloat(data[0].lon) };
    }
  } catch (e) { /* segue sem coordenadas */ }
  return { lat: null, lng: null };
}

