function MensagensView() {
  const { token } = useAuth();
  const [conversas, setConversas] = useState([]);
  const [ativaId, setAtivaId] = useState(null);
  const [mensagensAtiva, setMensagensAtiva] = useState([]);
  const [texto, setTexto] = useState("");
  const [carregando, setCarregando] = useState(true);
  const [erroCarregar, setErroCarregar] = useState("");

  const carregarConversas = () => {
    apiFetch("/mensagens", { token })
      .then(data => {
        setConversas(data);
        setErroCarregar("");
        setAtivaId(atual => atual || (data[0] ? data[0].id : null));
      })
      .catch(err => setErroCarregar(err.message))
      .finally(() => setCarregando(false));
  };

  useEffect(() => { carregarConversas(); }, []);

  useEffect(() => {
    if (!ativaId) return;
    apiFetch(`/mensagens/${ativaId}`, { token })
      .then(data => setMensagensAtiva(data.mensagens || []))
      .catch(() => {});
  }, [ativaId]);

  const ativa = conversas.find(c => c.id === ativaId);

  const handleEnviar = async () => {
    if (!texto.trim() || !ativaId) return;
    const textoEnviado = texto;
    setTexto("");
    try {
      await apiFetch(`/mensagens/${ativaId}`, { token, method: "POST", body: { texto: textoEnviado } });
      const atualizado = await apiFetch(`/mensagens/${ativaId}`, { token });
      setMensagensAtiva(atualizado.mensagens || []);
      carregarConversas();
    } catch (err) {
      setTexto(textoEnviado);
    }
  };

  const handleKeyDown = (e) => {
    if (e.key === "Enter") { e.preventDefault(); handleEnviar(); }
  };

  return (
    <div>
      <SectionHeader title="Mensagens" subtitle="Converse com clientes e entregadores" />
      {erroCarregar && (
        <div className="flex items-center gap-2 rounded-sm px-4 py-2.5 mb-4 text-sm" style={{ background: C.redDim, color: C.red, ...fontBody }}>
          <AlertTriangle size={14} /> Não foi possível carregar as conversas do backend ({erroCarregar}).
        </div>
      )}
      <div className="flex rounded-sm overflow-hidden" style={{ border: `1px solid ${C.line}`, height: 460 }}>
        <div className="w-72 shrink-0 overflow-y-auto" style={{ borderRight: `1px solid ${C.line}`, background: C.panel }}>
          {carregando && (
            <p className="text-sm p-4" style={{ color: C.faint, ...fontBody }}>Carregando conversas...</p>
          )}
          {conversas.map(c => {
            const ultima = c.mensagens && c.mensagens[0];
            return (
              <button
                key={c.id}
                onClick={() => setAtivaId(c.id)}
                className="w-full text-left px-4 py-3 block"
                style={{ background: ativaId === c.id ? C.panelAlt : "transparent", borderBottom: `1px solid ${C.line}` }}
              >
                <div className="flex items-center justify-between">
                  <span className="text-sm font-medium" style={{ color: C.text, ...fontBody }}>{c.nome}</span>
                  {c.naoLida && <span className="h-1.5 w-1.5 rounded-full" style={{ background: C.amber }} />}
                </div>
                <p className="text-xs mt-1 truncate" style={{ color: C.muted, ...fontBody }}>{ultima ? ultima.texto : "Sem mensagens ainda"}</p>
                {ultima && <span className="text-xs" style={{ color: C.faint, ...fontBody }}>{formatarHora(ultima.createdAt)}</span>}
              </button>
            );
          })}
          {!carregando && conversas.length === 0 && (
            <p className="text-sm p-4" style={{ color: C.faint, ...fontBody }}>Nenhuma conversa ainda.</p>
          )}
        </div>
        <div className="flex-1 flex flex-col" style={{ background: C.panelAlt }}>
          {ativa ? (
            <>
              <div className="px-4 py-3 flex items-center justify-between" style={{ borderBottom: `1px solid ${C.line}` }}>
                <span className="text-sm font-medium" style={{ color: C.text, ...fontBody }}>{ativa.nome}</span>
                <div className="flex gap-3">
                  <Phone size={14} style={{ color: C.faint }} />
                  <Mail size={14} style={{ color: C.faint }} />
                </div>
              </div>
              <div className="flex-1 p-4 flex flex-col gap-3 overflow-y-auto">
                {mensagensAtiva.map((m) => (
                  <div
                    key={m.id}
                    className={m.de === "NOS" ? "self-end max-w-xs px-3 py-2 rounded-sm text-sm" : "self-start max-w-xs px-3 py-2 rounded-sm text-sm"}
                    style={{
                      background: m.de === "NOS" ? C.amberDim : C.panel,
                      color: m.de === "NOS" ? C.amber : C.text,
                      ...fontBody,
                    }}
                  >
                    {m.texto}
                  </div>
                ))}
              </div>
              <div className="p-3 flex gap-2" style={{ borderTop: `1px solid ${C.line}` }}>
                <input
                  value={texto}
                  onChange={e => setTexto(e.target.value)}
                  onKeyDown={handleKeyDown}
                  placeholder="Escreva uma mensagem..."
                  className="flex-1 px-3 py-2 rounded-sm text-sm outline-none"
                  style={{ background: C.panel, border: `1px solid ${C.line}`, color: C.text, ...fontBody }}
                />
                <button onClick={handleEnviar} className="px-4 py-2 rounded-sm text-sm font-medium" style={{ background: C.amber, color: C.ink, ...fontBody }}>Enviar</button>
              </div>
            </>
          ) : (
            <div className="flex-1 flex items-center justify-center">
              <p className="text-sm" style={{ color: C.faint, ...fontBody }}>Selecione uma conversa.</p>
            </div>
          )}
        </div>
      </div>
    </div>
  );
}

