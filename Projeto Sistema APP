                className="px-4 py-2.5 rounded-sm text-sm font-medium flex-1"
                style={{
                  background: tipoDocumento === t ? C.amber : "transparent",
                  color: tipoDocumento === t ? C.ink : C.muted,
                  border: `1px solid ${tipoDocumento === t ? C.amber : C.line}`,
                  ...fontBody,
