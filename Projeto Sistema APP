                style={{ background: C.panelAlt, border: `1px solid ${C.line}`, color: C.text, ...fontBody }}
              />
            </div>

            {linkDev && (
              <div className="rounded-sm px-3 py-3 mb-5 text-xs" style={{ background: C.amberDim, color: C.amber, ...fontBody }}>
                <p className="mb-2">
                  <strong>Modo desenvolvimento:</strong> sem servidor de e-mail configurado, o backend devolveu o token de teste aqui.
                  Em produção esse token seria enviado por e-mail, nunca exibido na tela.
                </p>
                <p className="mb-2 break-all" style={{ color: C.text }}>{linkDev}</p>
                <button onClick={usarTokenDev} className="underline">Usar este token para redefinir agora</button>
              </div>
            )}

            <button
              onClick={handleSolicitarRecuperacao}
              disabled={carregando}
              className="w-full px-4 py-2.5 rounded-sm text-sm font-medium mb-3"
              style={{ background: C.amber, color: C.ink, opacity: carregando ? 0.6 : 1, ...fontBody }}
            >
              {carregando ? "Enviando..." : "Enviar link de redefinição"}
            </button>

            <button onClick={irParaLogin} className="text-xs" style={{ color: C.muted, ...fontBody }}>
              ← Voltar para login
            </button>
          </>
        )}

        {modo === "redefinir" && (
          <>
            <h1 className="text-lg font-semibold mb-1" style={{ color: C.text, ...fontHead }}>Redefinir senha</h1>
            <p className="text-xs mb-5" style={{ color: C.muted, ...fontBody }}>
              Cole o token recebido por e-mail (ou o link completo) e escolha uma nova senha.
            </p>

            {erro && (
              <div className="rounded-sm px-3 py-2.5 mb-4 text-xs" style={{ background: C.redDim, color: C.red, ...fontBody }}>{erro}</div>
            )}

            <div className="flex flex-col gap-3 mb-5">
              <div>
                <label className="block text-xs font-medium mb-1.5" style={{ color: C.muted, ...fontBody }}>Token de redefinição</label>
                <input
