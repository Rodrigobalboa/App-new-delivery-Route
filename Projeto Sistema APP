const TIPO_ENTREGA_MAP = { "Próprio": "PROPRIO", "Terceirizado": "TERCEIRIZADO", "Parceiro": "PARCEIRO" };
const TIPO_ENTREGA_MAP_REVERSE = Object.fromEntries(Object.entries(TIPO_ENTREGA_MAP).map(([k, v]) => [v, k]));
const STATUS_ENTREGADOR_MAP = { "Em análise": "EM_ANALISE", "Ativo": "ATIVO", "Inativo": "INATIVO" };
const STATUS_ENTREGADOR_MAP_REVERSE = Object.fromEntries(Object.entries(STATUS_ENTREGADOR_MAP).map(([k, v]) => [v, k]));
const PERMISSAO_COLETA_MAP = { "Todos os clientes": "TODOS_CLIENTES", "Somente selecionados": "SOMENTE_SELECIONADOS" };
const PERMISSAO_COLETA_MAP_REVERSE = Object.fromEntries(Object.entries(PERMISSAO_COLETA_MAP).map(([k, v]) => [v, k]));

const FORM_ENTREGADOR_VAZIO = () => ({
  nomeCompleto: "", cpf: "", rg: "", dataNascimento: "", telefone: "", email: "",
  cep: "", rua: "", numero: "", complemento: "", bairro: "", cidade: "",
  veiculoTipo: "Moto", veiculoModelo: "", veiculoPlaca: "", veiculoAno: "",
  cnhValida: "Sim", tipoEntrega: "", status: "Em análise", prioridade: "",
  taxaEntrega: "", permissaoColeta: "Todos os clientes",
});

function EntregadoresView() {
  const { token } = useAuth();
  const [foto, setFoto] = useState("");
  const [fotoCnh, setFotoCnh] = useState("");
  const [comprovanteResidencia, setComprovanteResidencia] = useState("");
  const [documentoVeiculo, setDocumentoVeiculo] = useState("");
  const [form, setForm] = useState(FORM_ENTREGADOR_VAZIO);
  const [comerciosSelecionados, setComerciosSelecionados] = useState([]);
  const [comerciosNomes, setComerciosNomes] = useState([]);
  const [entregadores, setEntregadores] = useState([]);
  const [contagemApi, setContagemApi] = useState({ emAnalise: 0, ativos: 0, inativos: 0 });
  const [editingId, setEditingId] = useState(null);
  const [csvFile, setCsvFile] = useState(null);
  const [carregando, setCarregando] = useState(true);
  const [salvando, setSalvando] = useState(false);
  const [erroCarregar, setErroCarregar] = useState("");
  const [feedback, setFeedback] = useState("");

  const showFeedback = (msg) => { setFeedback(msg); setTimeout(() => setFeedback(""), 2800); };
  const updateForm = (key, value) => setForm(f => ({ ...f, [key]: value }));

  const mapEntregadorApi = (e) => ({
    id: e.id,
    nome: e.nomeCompleto,
    veiculo: VEICULO_MAP_REVERSE[e.veiculoTipo] || e.veiculoTipo,
    tipoEntrega: TIPO_ENTREGA_MAP_REVERSE[e.tipoEntrega] || e.tipoEntrega,
    status: STATUS_ENTREGADOR_MAP_REVERSE[e.status] || e.status,
    prioridade: e.prioridadeBusca != null ? String(e.prioridadeBusca) : "—",
  });

  const carregarEntregadores = () => {
    apiFetch("/entregadores", { token })
      .then(data => { setEntregadores(data.map(mapEntregadorApi)); setErroCarregar(""); })
      .catch(err => setErroCarregar(err.message))
      .finally(() => setCarregando(false));
    apiFetch("/entregadores/contagem", { token }).then(setContagemApi).catch(() => {});
  };

  useEffect(() => {
    carregarEntregadores();
    apiFetch("/comercios", { token }).then(data => setComerciosNomes(data.map(c => c.nomeFantasia))).catch(() => {});
  }, []);

  const contagem = (status) => {
    if (status === "Em análise") return contagemApi.emAnalise;
    if (status === "Ativo") return contagemApi.ativos;
    return contagemApi.inativos;
  };

  const toggleComercioSelecionado = (nome) => {
    setComerciosSelecionados(sel => sel.includes(nome) ? sel.filter(n => n !== nome) : [...sel, nome]);
  };

  const resetForm = () => {
    setForm(FORM_ENTREGADOR_VAZIO());
    setFoto(""); setFotoCnh(""); setComprovanteResidencia(""); setDocumentoVeiculo("");
    setComerciosSelecionados([]);
    setEditingId(null);
  };

  const handleSalvar = async () => {
    if (!form.nomeCompleto.trim()) { showFeedback('Informe o "Nome completo" do entregador.'); return; }
    if (!form.tipoEntrega) { showFeedback('Selecione o "Tipo de entrega".'); return; }
    setSalvando(true);
    try {
      const body = {
        nomeCompleto: form.nomeCompleto,
        cpf: form.cpf || null,
        rg: form.rg || null,
        dataNascimento: form.dataNascimento || null,
        telefone: form.telefone || null,
        email: form.email || null,
        cep: form.cep || null,
        rua: form.rua || null,
        numero: form.numero || null,
        complemento: form.complemento || null,
        bairro: form.bairro || null,
        cidade: form.cidade || null,
        veiculoTipo: VEICULO_MAP[form.veiculoTipo] || "MOTO",
        veiculoModelo: form.veiculoModelo || null,
        veiculoPlaca: form.veiculoPlaca || null,
        veiculoAno: form.veiculoAno || null,
        cnhValida: form.cnhValida === "Sim",
        tipoEntrega: TIPO_ENTREGA_MAP[form.tipoEntrega],
        status: STATUS_ENTREGADOR_MAP[form.status] || "EM_ANALISE",
        prioridadeBusca: form.prioridade ? parseInt(form.prioridade, 10) : null,
        taxaEntrega: form.taxaEntrega ? parseFloat(String(form.taxaEntrega).replace(",", ".")) : null,
        permissaoColeta: PERMISSAO_COLETA_MAP[form.permissaoColeta] || "TODOS_CLIENTES",
      };
      if (editingId) {
        await apiFetch(`/entregadores/${editingId}`, { token, method: "PUT", body });
        showFeedback("Entregador atualizado com sucesso.");
      } else {
        await apiFetch("/entregadores", { token, method: "POST", body });
        showFeedback("Entregador salvo com sucesso.");
      }
      resetForm();
      carregarEntregadores();
    } catch (err) {
      showFeedback(err.message || "Não foi possível salvar o entregador.");
    } finally {
      setSalvando(false);
    }
  };

  const handleEditar = async (item) => {
    try {
      const full = await apiFetch(`/entregadores/${item.id}`, { token });
      setForm({
        nomeCompleto: full.nomeCompleto || "", cpf: full.cpf || "", rg: full.rg || "",
        dataNascimento: full.dataNascimento ? String(full.dataNascimento).slice(0, 10) : "",
        telefone: full.telefone || "", email: full.email || "",
        cep: full.cep || "", rua: full.rua || "", numero: full.numero || "",
        complemento: full.complemento || "", bairro: full.bairro || "", cidade: full.cidade || "",
        veiculoTipo: VEICULO_MAP_REVERSE[full.veiculoTipo] || "Moto",
        veiculoModelo: full.veiculoModelo || "", veiculoPlaca: full.veiculoPlaca || "", veiculoAno: full.veiculoAno || "",
        cnhValida: full.cnhValida ? "Sim" : "Não",
        tipoEntrega: TIPO_ENTREGA_MAP_REVERSE[full.tipoEntrega] || "",
        status: STATUS_ENTREGADOR_MAP_REVERSE[full.status] || "Em análise",
        prioridade: full.prioridadeBusca != null ? String(full.prioridadeBusca) : "",
        taxaEntrega: full.taxaEntrega != null ? String(full.taxaEntrega) : "",
        permissaoColeta: PERMISSAO_COLETA_MAP_REVERSE[full.permissaoColeta] || "Todos os clientes",
      });
      setEditingId(item.id);
      showFeedback("Editando entregador — ajuste os campos e salve novamente.");
    } catch (err) {
      showFeedback(err.message || "Não foi possível carregar os dados do entregador.");
    }
  };

  const handleExcluir = async (id) => {
    try {
      await apiFetch(`/entregadores/${id}`, { token, method: "DELETE" });
      if (editingId === id) resetForm();
      showFeedback("Entregador removido.");
      carregarEntregadores();
    } catch (err) {
      showFeedback(err.message || "Não foi possível remover o entregador.");
    }
  };

  const handleImportarCSV = () => {
    if (!csvFile) { showFeedback("Selecione um arquivo CSV para importar."); return; }
    const reader = new FileReader();
    reader.onload = async (e) => {
      try {
        const texto = String(e.target.result || "");
        const resultado = await apiFetch("/entregadores/import", { token, method: "POST", body: { csv: texto } });
        showFeedback(`${resultado.importados} entregador(es) importado(s) de "${csvFile.name}".`);
        setCsvFile(null);
        carregarEntregadores();
      } catch (err) {
        showFeedback(err.message || "Não foi possível importar o CSV.");
      }
    };
    reader.readAsText(csvFile);
  };

  return (
    <div>
      <SectionHeader title="Entregadores" subtitle="Cadastro, documentos e importação em massa de entregadores" />

      {feedback && (
        <div className="flex items-center gap-2 rounded-sm px-4 py-2.5 mb-5 text-sm" style={{ background: C.greenDim, color: C.green, ...fontBody }}>
          <CheckCircle2 size={14} /> {feedback}
        </div>
      )}
      {erroCarregar && (
        <div className="flex items-center gap-2 rounded-sm px-4 py-2.5 mb-5 text-sm" style={{ background: C.redDim, color: C.red, ...fontBody }}>
          <AlertTriangle size={14} /> Não foi possível carregar os entregadores do backend ({erroCarregar}).
        </div>
      )}

      <div className="mb-8">
        <h2 className="text-sm font-semibold mb-3" style={{ color: C.text, ...fontHead }}>Gestão de Entregadores</h2>
        <div className="flex gap-3">
          <StatCard label="Em análise" value={contagem("Em análise")} icon={Clock} />
          <StatCard label="Ativos" value={contagem("Ativo")} delta="disponíveis para entrega" deltaGood icon={CheckCircle2} />
          <StatCard label="Inativos" value={contagem("Inativo")} icon={AlertTriangle} />
        </div>
      </div>

      <div className="mb-8 max-w-xs">
        <FileField label="Foto do entregador" value={foto} onChange={setFoto} />
      </div>

      <div className="mb-8 grid grid-cols-3 gap-4 max-w-4xl">
        <Field label="Nome completo"><TextInput placeholder="Nome do entregador" value={form.nomeCompleto} onChange={e => updateForm("nomeCompleto", e.target.value)} /></Field>
        <Field label="CPF"><TextInput placeholder="000.000.000-00" value={form.cpf} onChange={e => updateForm("cpf", e.target.value)} /></Field>
        <Field label="RG"><TextInput placeholder="00.000.000-0" value={form.rg} onChange={e => updateForm("rg", e.target.value)} /></Field>
        <Field label="Data de nascimento"><TextInput type="date" value={form.dataNascimento} onChange={e => updateForm("dataNascimento", e.target.value)} /></Field>
        <Field label="Telefone"><TextInput placeholder="(11) 90000-0000" value={form.telefone} onChange={e => updateForm("telefone", e.target.value)} /></Field>
        <Field label="E-mail"><TextInput type="email" placeholder="entregador@email.com" value={form.email} onChange={e => updateForm("email", e.target.value)} /></Field>
      </div>

      <div className="mb-8 grid grid-cols-3 gap-4 max-w-4xl">
        <Field label="CEP"><TextInput placeholder="00000-000" value={form.cep} onChange={e => updateForm("cep", e.target.value)} /></Field>
        <Field label="Rua"><TextInput placeholder="Nome da rua" value={form.rua} onChange={e => updateForm("rua", e.target.value)} /></Field>
        <Field label="Número"><TextInput placeholder="Ex: 120" value={form.numero} onChange={e => updateForm("numero", e.target.value)} /></Field>
        <Field label="Complemento"><TextInput placeholder="Opcional" value={form.complemento} onChange={e => updateForm("complemento", e.target.value)} /></Field>
        <Field label="Bairro"><TextInput placeholder="Bairro" value={form.bairro} onChange={e => updateForm("bairro", e.target.value)} /></Field>
        <Field label="Cidade"><TextInput placeholder="Cidade" value={form.cidade} onChange={e => updateForm("cidade", e.target.value)} /></Field>
      </div>

      <div className="mb-8 max-w-4xl">
        <label className="block text-xs font-medium mb-1.5" style={{ color: C.muted, ...fontBody }}>Tipo de veículo</label>
        <div className="flex gap-1.5 mb-4">
          {TIPOS_VEICULO.map(v => (
            <button
              key={v}
              onClick={() => updateForm("veiculoTipo", v)}
              className="px-4 py-2 rounded-sm text-sm font-medium"
              style={{
                background: form.veiculoTipo === v ? C.amber : "transparent",
                color: form.veiculoTipo === v ? C.ink : C.muted,
                border: `1px solid ${form.veiculoTipo === v ? C.amber : C.line}`,
                ...fontBody,
              }}
            >
              {v}
            </button>
          ))}
        </div>
        <div className="grid grid-cols-3 gap-4">
          <Field label="Modelo do veículo"><TextInput placeholder="Ex: Honda CG 160" value={form.veiculoModelo} onChange={e => updateForm("veiculoModelo", e.target.value)} /></Field>
          <Field label="Placa"><TextInput placeholder="ABC-1D23" value={form.veiculoPlaca} onChange={e => updateForm("veiculoPlaca", e.target.value)} /></Field>
          <Field label="Ano"><TextInput placeholder="Ex: 2022" value={form.veiculoAno} onChange={e => updateForm("veiculoAno", e.target.value)} /></Field>
        </div>
      </div>

      <div className="mb-8 max-w-md">
        <label className="block text-xs font-medium mb-1.5" style={{ color: C.muted, ...fontBody }}>CNH válida</label>
        <div className="flex gap-1.5">
          {["Sim", "Não"].map(v => (
            <button
              key={v}
              onClick={() => updateForm("cnhValida", v)}
              className="px-4 py-2 rounded-sm text-sm font-medium flex-1"
              style={{
                background: form.cnhValida === v ? C.amber : "transparent",
                color: form.cnhValida === v ? C.ink : C.muted,
                border: `1px solid ${form.cnhValida === v ? C.amber : C.line}`,
                ...fontBody,
              }}
            >
              {v}
            </button>
          ))}
        </div>
      </div>

      <div className="mb-8 grid grid-cols-2 gap-4 max-w-2xl">
        <Field label="Tipo de entrega">
          <SelectInput value={form.tipoEntrega} onChange={e => updateForm("tipoEntrega", e.target.value)} options={TIPOS_ENTREGA_ENTREGADOR} />
        </Field>
        <Field label="Status">
          <SelectInput value={form.status} onChange={e => updateForm("status", e.target.value)} options={STATUS_ENTREGADOR} placeholder="Em análise" />
        </Field>
      </div>

      <div className="mb-8 grid grid-cols-2 gap-4 max-w-2xl">
        <Field label="Prioridade de busca" helper="Define a ordem de prioridade no algoritmo de despacho automático">
          <TextInput type="number" placeholder="Ex: 8" value={form.prioridade} onChange={e => updateForm("prioridade", e.target.value)} />
        </Field>
        <Field label="Taxa de entrega" helper="Valor fixo pago ao entregador por corrida, se aplicável">
          <TextInput placeholder="R$ 0,00" value={form.taxaEntrega} onChange={e => updateForm("taxaEntrega", e.target.value)} />
        </Field>
      </div>

      <div className="mb-8 max-w-2xl">
        <label className="block text-xs font-medium mb-1.5" style={{ color: C.muted, ...fontBody }}>Permissão de coleta</label>
        <div className="flex gap-1.5 mb-3">
          {["Todos os clientes", "Somente selecionados"].map(v => (
            <button
              key={v}
              onClick={() => updateForm("permissaoColeta", v)}
              className="px-4 py-2 rounded-sm text-sm font-medium flex-1"
              style={{
                background: form.permissaoColeta === v ? C.amber : "transparent",
                color: form.permissaoColeta === v ? C.ink : C.muted,
                border: `1px solid ${form.permissaoColeta === v ? C.amber : C.line}`,
                ...fontBody,
              }}
            >
              {v}
            </button>
          ))}
        </div>
        {form.permissaoColeta === "Somente selecionados" && (
          <div className="rounded-sm p-3 flex flex-col gap-2" style={{ background: C.panel, border: `1px solid ${C.line}` }}>
            {comerciosNomes.map(nome => (
              <label key={nome} className="flex items-center gap-2 text-sm cursor-pointer" style={{ color: C.text, ...fontBody }}>
                <input
                  type="checkbox"
                  checked={comerciosSelecionados.includes(nome)}
                  onChange={() => toggleComercioSelecionado(nome)}
                  style={{ accentColor: C.amber }}
                />
                {nome}
              </label>
            ))}
          </div>
        )}
      </div>

      <div className="mb-8 grid grid-cols-3 gap-4 max-w-4xl">
        <FileField label="Foto da CNH" value={fotoCnh} onChange={setFotoCnh} />
        <FileField label="Comprovante de residência" value={comprovanteResidencia} onChange={setComprovanteResidencia} />
        <FileField label={`Documento da ${form.veiculoTipo}`} value={documentoVeiculo} onChange={setDocumentoVeiculo} />
      </div>

      <button onClick={handleSalvar} disabled={salvando} className="mb-12 px-6 py-2.5 rounded-sm text-sm font-medium" style={{ background: C.amber, color: C.ink, opacity: salvando ? 0.6 : 1, ...fontBody }}>
        {salvando ? "Salvando..." : editingId ? "Salvar alterações" : "Salvar entregador"}
      </button>

      <div className="mb-10 max-w-3xl rounded-sm p-4" style={{ background: C.panel, border: `1px solid ${C.line}` }}>
        <div className="flex items-center gap-2 mb-1">
          <Upload size={14} style={{ color: C.amber }} />
          <h2 className="text-sm font-semibold" style={{ color: C.text, ...fontHead }}>Importar entregadores via CSV</h2>
        </div>
        <p className="text-xs mb-3" style={{ color: C.faint, ...fontBody }}>
          Cabeçalho esperado no arquivo:
        </p>
        <div className="rounded-sm px-3 py-2.5 mb-4 text-xs" style={{ background: C.panelAlt, border: `1px solid ${C.line}`, color: C.muted, fontFamily: "monospace", lineHeight: 1.6 }}>
          {CSV_HEADER}
        </div>
        <div className="flex items-center gap-3">
          <label className="flex items-center gap-3 px-3 py-2.5 rounded-sm cursor-pointer flex-1" style={{ background: C.panelAlt, border: `1px solid ${C.line}` }}>
            <span className="px-2.5 py-1 rounded-sm text-xs font-medium shrink-0" style={{ background: C.panel, color: C.muted, ...fontBody }}>
              Escolher arquivo
            </span>
            <span className="text-xs truncate" style={{ color: csvFile ? C.text : C.faint, ...fontBody }}>
              {csvFile ? csvFile.name : "Nenhum arquivo escolhido"}
            </span>
            <input type="file" accept=".csv" className="hidden" onChange={e => setCsvFile(e.target.files && e.target.files[0] ? e.target.files[0] : null)} />
          </label>
          <button onClick={handleImportarCSV} className="px-4 py-2.5 rounded-sm text-sm font-medium whitespace-nowrap" style={{ background: C.amber, color: C.ink, ...fontBody }}>
            Importar entregadores
          </button>
        </div>
      </div>

      <div>
        <h2 className="text-sm font-semibold mb-3" style={{ color: C.text, ...fontHead }}>Entregadores cadastrados</h2>
        <div className="rounded-sm overflow-hidden" style={{ border: `1px solid ${C.line}` }}>
          <table className="w-full text-sm">
            <thead>
              <tr style={{ background: C.panelAlt }}>
                {["Nome", "Veículo", "Tipo de entrega", "Status", "Prioridade"].map(h => (
                  <th key={h} className="text-left px-4 py-2.5 text-xs font-medium" style={{ color: C.faint, ...fontBody }}>{h}</th>
                ))}
                <th className="text-right px-4 py-2.5 text-xs font-medium" style={{ color: C.faint, ...fontBody }}>Ações</th>
              </tr>
            </thead>
            <tbody>
              {entregadores.map((e, i) => (
                <tr key={e.id} style={{ background: C.panel, borderTop: i > 0 ? `1px solid ${C.line}` : "none" }}>
                  <td className="px-4 py-3 font-medium" style={{ color: C.text, ...fontBody }}>{e.nome}</td>
                  <td className="px-4 py-3" style={{ color: C.muted, ...fontBody }}>{e.veiculo}</td>
                  <td className="px-4 py-3" style={{ color: C.muted, ...fontBody }}>{e.tipoEntrega}</td>
                  <td className="px-4 py-3">
                    <span style={{
                      color: e.status === "Ativo" ? C.green : e.status === "Inativo" ? C.red : C.amber,
                      ...fontBody,
                    }}>
                      {e.status}
                    </span>
                  </td>
                  <td className="px-4 py-3" style={{ color: C.text, ...fontBody }}>{e.prioridade}</td>
                  <td className="px-4 py-3 text-right whitespace-nowrap">
                    <button onClick={() => handleEditar(e)} className="text-xs font-medium mr-4" style={{ color: C.blue }}>Editar</button>
                    <button onClick={() => handleExcluir(e.id)} className="text-xs font-medium" style={{ color: C.red }}>Excluir</button>
                  </td>
                </tr>
              ))}
              {entregadores.length === 0 && (
                <tr style={{ background: C.panel }}>
                  <td colSpan={6} className="px-4 py-8 text-center text-sm" style={{ color: C.faint, ...fontBody }}>
                    {carregando ? "Carregando entregadores..." : "Nenhum entregador cadastrado ainda."}
                  </td>
                </tr>
              )}
            </tbody>
          </table>
        </div>
      </div>
    </div>
  );
}

// ---------- Tabela de preço por KM ----------

const TIPOS_CALCULO_TABELA = ["Deslocamento", "Fixo"];
const TIPOS_RETORNO_TABELA = ["Porcentagem", "Valor Fixo"];

const TIPO_CALCULO_MAP = { "Deslocamento": "DESLOCAMENTO", "Fixo": "FIXO" };
const TIPO_CALCULO_MAP_REVERSE = Object.fromEntries(Object.entries(TIPO_CALCULO_MAP).map(([k, v]) => [v, k]));
const TIPO_RETORNO_TABELA_MAP = { "Porcentagem": "PORCENTAGEM", "Valor Fixo": "VALOR_FIXO" };
const TIPO_RETORNO_TABELA_MAP_REVERSE = Object.fromEntries(Object.entries(TIPO_RETORNO_TABELA_MAP).map(([k, v]) => [v, k]));

function parseNumeroBR(v) {
  if (v === "" || v == null) return null;
  const n = parseFloat(String(v).replace(",", "."));
  return isNaN(n) ? null : n;
}
function formatNumeroBR(v) {
  if (v == null) return "";
  return String(v).replace(".", ",");
}

const FORM_TABELA_KM_VAZIO = () => ({
  nome: "", tipoCalculo: "Deslocamento", kmAdicional: "",
  tipoRetorno: "Porcentagem", retorno: "", valorMinimo: "",
  valorPorPonto: "", valorMultiplo: "",
});

function TabelaPrecoKmView() {
  const { token } = useAuth();
  const [form, setForm] = useState(FORM_TABELA_KM_VAZIO);
  const [tabelas, setTabelas] = useState([]);
  const [editingId, setEditingId] = useState(null);
  const [carregando, setCarregando] = useState(true);
  const [salvando, setSalvando] = useState(false);
  const [erroCarregar, setErroCarregar] = useState("");
  const [feedback, setFeedback] = useState("");

  const showFeedback = (msg) => { setFeedback(msg); setTimeout(() => setFeedback(""), 2600); };
  const updateForm = (key, value) => setForm(f => ({ ...f, [key]: value }));
  const resetForm = () => { setForm(FORM_TABELA_KM_VAZIO()); setEditingId(null); };

  const mapTabelaApi = (t) => ({
    id: t.id,
    nome: t.nome,
    tipoCalculo: TIPO_CALCULO_MAP_REVERSE[t.tipoCalculo] || "Deslocamento",
    kmAdicional: formatNumeroBR(t.kmAdicional),
    tipoRetorno: TIPO_RETORNO_TABELA_MAP_REVERSE[t.tipoRetorno] || "Porcentagem",
    retorno: formatNumeroBR(t.retorno),
    valorMinimo: formatNumeroBR(t.valorMinimo),
    valorPorPonto: formatNumeroBR(t.valorPorPonto),
    valorMultiplo: formatNumeroBR(t.valorMultiplo),
  });

  const carregarTabelas = () => {
    apiFetch("/cadastro/tabela-preco-km", { token })
      .then(data => { setTabelas(data.map(mapTabelaApi)); setErroCarregar(""); })
      .catch(err => setErroCarregar(err.message))
      .finally(() => setCarregando(false));
  };

  useEffect(() => { carregarTabelas(); }, []);

  const handleCadastrar = async () => {
    if (!form.nome.trim()) { showFeedback('Informe o "Nome da tabela".'); return; }
    setSalvando(true);
    try {
      const body = {
        nome: form.nome,
        tipoCalculo: TIPO_CALCULO_MAP[form.tipoCalculo] || "DESLOCAMENTO",
        kmAdicional: parseNumeroBR(form.kmAdicional),
        tipoRetorno: TIPO_RETORNO_TABELA_MAP[form.tipoRetorno] || "PORCENTAGEM",
        retorno: parseNumeroBR(form.retorno),
        valorMinimo: parseNumeroBR(form.valorMinimo),
        valorPorPonto: parseNumeroBR(form.valorPorPonto),
        valorMultiplo: parseNumeroBR(form.valorMultiplo),
      };
      if (editingId) {
        await apiFetch(`/cadastro/tabela-preco-km/${editingId}`, { token, method: "PUT", body });
        showFeedback("Tabela atualizada com sucesso.");
      } else {
        await apiFetch("/cadastro/tabela-preco-km", { token, method: "POST", body });
        showFeedback("Tabela cadastrada com sucesso.");
      }
      resetForm();
      carregarTabelas();
    } catch (err) {
      showFeedback(err.message || "Não foi possível salvar a tabela.");
    } finally {
      setSalvando(false);
    }
  };

  const handleEditar = (t) => {
    setForm({ ...t });
    setEditingId(t.id);
    showFeedback("Editando tabela — ajuste os campos e cadastre novamente.");
  };

  const handleExcluir = async (id) => {
    try {
      await apiFetch(`/cadastro/tabela-preco-km/${id}`, { token, method: "DELETE" });
      if (editingId === id) resetForm();
      showFeedback("Tabela removida.");
      carregarTabelas();
    } catch (err) {
      showFeedback(err.message || "Não foi possível remover a tabela.");
    }
  };

  return (
    <div>
      <SectionHeader title="Tabela de preço por KM" subtitle="Configure as regras de cálculo de distância e retorno da plataforma" />

      {feedback && (
        <div className="flex items-center gap-2 rounded-sm px-4 py-2.5 mb-5 text-sm" style={{ background: C.greenDim, color: C.green, ...fontBody }}>
          <CheckCircle2 size={14} /> {feedback}
        </div>
      )}

      <div className="max-w-3xl mb-10">
        <h2 className="text-sm font-semibold mb-4" style={{ color: C.text, ...fontHead }}>
          {editingId ? "Editar tabela" : "Adicionar tabela"}
        </h2>

        <div className="grid grid-cols-2 gap-4 mb-5">
          <div className="col-span-2">
            <Field label="Nome da tabela">
              <TextInput placeholder="Ex: Tabela Padrão Centro" value={form.nome} onChange={e => updateForm("nome", e.target.value)} />
            </Field>
          </div>

          <div>
            <label className="block text-xs font-medium mb-1.5" style={{ color: C.muted, ...fontBody }}>Tipo de cálculo</label>
            <div className="flex gap-1.5">
              {TIPOS_CALCULO_TABELA.map(t => (
                <button
                  key={t}
                  onClick={() => updateForm("tipoCalculo", t)}
                  className="px-4 py-2 rounded-sm text-sm font-medium flex-1"
                  style={{
                    background: form.tipoCalculo === t ? C.amber : "transparent",
                    color: form.tipoCalculo === t ? C.ink : C.muted,
                    border: `1px solid ${form.tipoCalculo === t ? C.amber : C.line}`,
                    ...fontBody,
                  }}
                >
                  {t}
                </button>
              ))}
            </div>
          </div>

          {form.tipoCalculo === "Deslocamento" ? (
            <Field label="Km adicional" helper="Valor cobrado por km que exceder a distância base (R$)">
              <TextInput placeholder="R$ 0,00" value={form.kmAdicional} onChange={e => updateForm("kmAdicional", e.target.value)} />
            </Field>
          ) : (
            <div className="flex items-end">
              <p className="text-xs pb-2.5" style={{ color: C.faint, ...fontBody }}>
                Tabelas do tipo "Fixo" não usam km adicional — o valor não varia com a distância.
              </p>
            </div>
          )}

          <div>
            <label className="block text-xs font-medium mb-1.5" style={{ color: C.muted, ...fontBody }}>Tipo de retorno</label>
            <div className="flex gap-1.5">
              {TIPOS_RETORNO_TABELA.map(t => (
                <button
                  key={t}
                  onClick={() => updateForm("tipoRetorno", t)}
                  className="px-4 py-2 rounded-sm text-sm font-medium flex-1"
                  style={{
                    background: form.tipoRetorno === t ? C.amber : "transparent",
                    color: form.tipoRetorno === t ? C.ink : C.muted,
                    border: `1px solid ${form.tipoRetorno === t ? C.amber : C.line}`,
                    ...fontBody,
                  }}
                >
                  {t}
                </button>
              ))}
            </div>
          </div>

          <Field
            label="Retorno"
            helper={form.tipoRetorno === "Porcentagem" ? "Percentual sobre valor destinatário (%)" : "Valor fixo de retorno (R$)"}
          >
            <TextInput
              placeholder={form.tipoRetorno === "Porcentagem" ? "Ex: 18" : "R$ 0,00"}
              value={form.retorno}
              onChange={e => updateForm("retorno", e.target.value)}
            />
          </Field>

          <Field label="Valor mínimo">
            <TextInput placeholder="R$ 0,00" value={form.valorMinimo} onChange={e => updateForm("valorMinimo", e.target.value)} />
          </Field>

          <Field label="Valor por ponto">
            <TextInput placeholder="R$ 0,00" value={form.valorPorPonto} onChange={e => updateForm("valorPorPonto", e.target.value)} />
          </Field>

          <Field label="Valor Múltiplo (Comércio)" helper="Valor fixo para 2ª entrega em diante (pedidos múltiplos)">
            <TextInput placeholder="R$ 0,00" value={form.valorMultiplo} onChange={e => updateForm("valorMultiplo", e.target.value)} />
          </Field>
        </div>

        <div className="flex gap-2">
          <button
            onClick={resetForm}
            className="px-5 py-2.5 rounded-sm text-sm font-medium"
            style={{ border: `1px solid ${C.line}`, color: C.muted, ...fontBody }}
          >
            Cancelar
          </button>
          <button
            onClick={handleCadastrar}
            className="px-5 py-2.5 rounded-sm text-sm font-medium"
            style={{ background: C.amber, color: C.ink, ...fontBody }}
          >
            {editingId ? "Salvar tabela" : "Cadastrar tabela"}
          </button>
        </div>
      </div>

      <div>
        <h2 className="text-sm font-semibold mb-3" style={{ color: C.text, ...fontHead }}>Tabelas cadastradas</h2>
        <div className="rounded-sm overflow-hidden" style={{ border: `1px solid ${C.line}` }}>
          <table className="w-full text-sm">
            <thead>
              <tr style={{ background: C.panelAlt }}>
                {["Nome", "Tipo de cálculo", "Tipo de retorno", "Retorno", "Valor mínimo"].map(h => (
                  <th key={h} className="text-left px-4 py-2.5 text-xs font-medium" style={{ color: C.faint, ...fontBody }}>{h}</th>
                ))}
                <th className="text-right px-4 py-2.5 text-xs font-medium" style={{ color: C.faint, ...fontBody }}>Ações</th>
              </tr>
            </thead>
            <tbody>
              {tabelas.map((t, i) => (
                <tr key={t.id} style={{ background: C.panel, borderTop: i > 0 ? `1px solid ${C.line}` : "none" }}>
                  <td className="px-4 py-3 font-medium" style={{ color: C.text, ...fontBody }}>{t.nome}</td>
                  <td className="px-4 py-3" style={{ color: C.muted, ...fontBody }}>{t.tipoCalculo}</td>
                  <td className="px-4 py-3" style={{ color: C.muted, ...fontBody }}>{t.tipoRetorno}</td>
                  <td className="px-4 py-3" style={{ color: C.text, ...fontBody }}>
                    {t.retorno}{t.tipoRetorno === "Porcentagem" ? "%" : ""}
                  </td>
                  <td className="px-4 py-3" style={{ color: C.text, ...fontBody }}>{t.valorMinimo}</td>
                  <td className="px-4 py-3 text-right whitespace-nowrap">
                    <button onClick={() => handleEditar(t)} className="text-xs font-medium mr-4" style={{ color: C.blue }}>Editar</button>
                    <button onClick={() => handleExcluir(t.id)} className="text-xs font-medium" style={{ color: C.red }}>Excluir</button>
                  </td>
                </tr>
              ))}
              {tabelas.length === 0 && (
                <tr style={{ background: C.panel }}>
                  <td colSpan={6} className="px-4 py-8 text-center text-sm" style={{ color: C.faint, ...fontBody }}>Nenhuma tabela cadastrada ainda.</td>
                </tr>
              )}
            </tbody>
          </table>
        </div>
      </div>
    </div>
  );
}

