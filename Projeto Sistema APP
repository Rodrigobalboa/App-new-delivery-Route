      let enderecosPayload = [];
      if (enderecos.length > 0) {
        const coords = await geocodificarEnderecoSimples(enderecos[0]);
        enderecosPayload = enderecos.map((e, i) => ({
          rua: e.rua, numero: e.numero || null, bairro: e.bairro || null,
          cidade: e.cidade || null, cep: e.cep || null,
          lat: i === 0 ? coords.lat : null, lng: i === 0 ? coords.lng : null,
          principal: i === 0,
        }));
      }

      const precificacoesPayload = VEICULOS_MODAL
        .filter(v => precificacao[v].preco || precificacao[v].tabela)
        .map(v => ({
          veiculo: v.toUpperCase(),
          precoPorPonto: precificacao[v].preco ? parseFloat(String(precificacao[v].preco).replace(",", ".")) : null,
          tipoPrecificacao: TIPO_PRECIFICACAO_MAP[precificacao[v].tipo] || "PADRAO",
          tabelaPrecoKmId: precificacao[v].tabela || null,
        }));

      const usuariosPayload = usuariosAdicionais
        .filter(u => u.email && !u.id.toString().startsWith("usr-existente-"))
        .map(u => ({ email: u.email, senha: u.senha }));

      const flatBody = {
        nomeFantasia: form.nomeFantasia || form.razaoSocial,
        razaoSocial: form.razaoSocial || null,
        segmento: form.segmento || null,
        dataInicio: form.dataInicio || null,
        tabelaComissaoId: form.tabelaComissao || null,
        cadastroVia: CADASTRO_VIA_MAP[form.cadastroVia] || null,
        tipoDocumento,
        documento: form.documento || null,
        franquia: form.franquias || null,
        hub: form.hubs || null,
        leadCadastradoPor: form.leadPor || null,
        nomeCompleto: form.nomeCompleto || null,
        dataNascimento: form.dataNascimento || null,
        telefone: form.telefone || null,
        email: form.email || null,
        metodoPagamento: form.metodoPagamento || null,
        observacoes: form.observacoes || null,
      };

      if (editingId) {
        await apiFetch(`/comercios/${editingId}`, { token, method: "PUT", body: flatBody });
        for (const end of enderecosPayload) {
          await apiFetch(`/comercios/${editingId}/enderecos`, { token, method: "POST", body: end });
        }
        for (const p of precificacoesPayload) {
          await apiFetch(`/comercios/${editingId}/precificacao-modal/${p.veiculo}`, { token, method: "PUT", body: p });
        }
        for (const u of usuariosPayload) {
          await apiFetch(`/comercios/${editingId}/usuarios`, { token, method: "POST", body: u });
        }
        showFeedback("Comércio atualizado com sucesso.");
      } else {
        await apiFetch("/comercios", {
          token, method: "POST",
          body: { ...flatBody, enderecos: enderecosPayload, precificacoesModal: precificacoesPayload, usuariosAdicionais: usuariosPayload },
        });
        showFeedback(
          usuariosPayload.length > 0
            ? `Comércio salvo com sucesso. ${usuariosPayload.length} usuário(s) adicional(is) criado(s).`
            : "Comércio salvo com sucesso."
        );
      }
      resetForm();
      carregarComercios();
    } catch (err) {
      showFeedback(err.message || "Não foi possível salvar o comércio.");
    } finally {
      setSalvando(false);
    }
  };

  const handleEditar = async (item) => {
    try {
      const full = await apiFetch(`/comercios/${item.id}`, { token });
      setForm({
        segmento: full.segmento || "",
        dataInicio: full.dataInicio ? String(full.dataInicio).slice(0, 10) : "",
        razaoSocial: full.razaoSocial || "",
        nomeFantasia: full.nomeFantasia || "",
        tabelaComissao: full.tabelaComissaoId || "",
        cadastroVia: CADASTRO_VIA_MAP_REVERSE[full.cadastroVia] || "",
        franquias: full.franquia || "",
        hubs: full.hub || "",
        leadPor: full.leadCadastradoPor || "",
        nomeCompleto: full.nomeCompleto || "",
        documento: full.documento || "",
        dataNascimento: full.dataNascimento ? String(full.dataNascimento).slice(0, 10) : "",
        telefone: full.telefone || "",
        email: full.email || "",
        senha: "",
        metodoPagamento: full.metodoPagamento || "",
        observacoes: full.observacoes || "",
      });
      setTipoDocumento(full.tipoDocumento || "CNPJ");

      const novaPrecificacao = PRECIFICACAO_VAZIA();
      (full.precificacoesModal || []).forEach(p => {
        const chave = p.veiculo.toLowerCase();
        if (novaPrecificacao[chave]) {
          novaPrecificacao[chave] = {
            preco: p.precoPorPonto != null ? String(p.precoPorPonto) : "",
            tipo: TIPO_PRECIFICACAO_MAP_REVERSE[p.tipoPrecificacao] || "Padrão",
            tabela: p.tabelaPrecoKmId || "",
          };
        }
      });
      setPrecificacao(novaPrecificacao);
      setEnderecos((full.enderecos || []).map(e => ({ ...e, id: e.id })));
      setUsuariosAdicionais((full.usuariosAdicionais || []).map(u => ({ id: `usr-existente-${u.id}`, email: u.email, senha: "" })));
      setEditingId(item.id);
      showFeedback("Editando comércio — ajuste os campos e salve novamente.");
    } catch (err) {
      showFeedback(err.message || "Não foi possível carregar os dados do comércio.");
    }
  };

  const handleExcluir = async (id) => {
    try {
      await apiFetch(`/comercios/${id}`, { token, method: "DELETE" });
      if (editingId === id) resetForm();
      showFeedback("Comércio removido.");
      carregarComercios();
    } catch (err) {
      showFeedback(err.message || "Não foi possível remover o comércio.");
    }
  };

  return (
    <div>
      <SectionHeader title="Comércio" subtitle="Cadastro completo de estabelecimentos parceiros" />

      {feedback && (
        <div className="flex items-center gap-2 rounded-sm px-4 py-2.5 mb-5 text-sm" style={{ background: C.greenDim, color: C.green, ...fontBody }}>
          <CheckCircle2 size={14} /> {feedback}
        </div>
      )}
      {erroCarregar && (
        <div className="flex items-center gap-2 rounded-sm px-4 py-2.5 mb-5 text-sm" style={{ background: C.redDim, color: C.red, ...fontBody }}>
          <AlertTriangle size={14} /> Não foi possível carregar os comércios do backend ({erroCarregar}).
        </div>
      )}

      <div className="flex gap-6 mb-8">
        <div>
          <label className="block text-xs font-medium mb-1.5" style={{ color: C.muted, ...fontBody }}>Selecione uma foto</label>
          <label className="flex flex-col items-center justify-center gap-1.5 cursor-pointer rounded-sm overflow-hidden" style={{ width: 96, height: 96, background: C.panel, border: `1px dashed ${C.line}` }}>
            {foto ? (
              <img src={foto} alt="Foto do comércio" className="w-full h-full object-cover" />
            ) : (
              <>
                <ImageIcon size={20} style={{ color: C.faint }} />
                <span className="text-xs" style={{ color: C.faint, ...fontBody }}>Selecionar</span>
              </>
            )}
            <input type="file" accept="image/*" className="hidden" onChange={handleFotoChange} />
          </label>
        </div>
        <div className="flex-1 grid grid-cols-2 gap-4">
          <Field label="Segmento">
            <SelectInput value={form.segmento} onChange={e => updateForm("segmento", e.target.value)} options={SEGMENTOS} />
          </Field>
          <Field label="Data de início">
            <TextInput type="date" value={form.dataInicio} onChange={e => updateForm("dataInicio", e.target.value)} />
          </Field>
          <Field label="Razão social">
            <TextInput placeholder="Razão social da empresa" value={form.razaoSocial} onChange={e => updateForm("razaoSocial", e.target.value)} />
          </Field>
          <Field label="Nome fantasia">
            <TextInput placeholder="Nome exibido no app" value={form.nomeFantasia} onChange={e => updateForm("nomeFantasia", e.target.value)} />
          </Field>
        </div>
      </div>

      <div className="mb-8">
        <h2 className="text-sm font-semibold mb-1" style={{ color: C.text, ...fontHead }}>Precificação por modal</h2>
        <p className="text-xs mb-4" style={{ color: C.muted, ...fontBody }}>
          Configure a tabela de preço específica para este cliente em cada modal. O valor será calculado automaticamente na criação da entrega.
        </p>
        <div className="flex flex-col gap-3">
          {VEICULOS_MODAL.map(veiculo => (
            <div key={veiculo} className="rounded-sm p-4" style={{ background: C.panel, border: `1px solid ${C.line}` }}>
              <div className="flex items-center gap-2 mb-3">
                <Truck size={14} style={{ color: C.amber }} />
                <span className="text-sm font-medium capitalize" style={{ color: C.text, ...fontBody }}>Veículo: {veiculo}</span>
              </div>
              <div className="grid grid-cols-3 gap-4">
                <Field label="Preço por ponto">
                  <TextInput placeholder="Ex: 4,50" value={precificacao[veiculo].preco} onChange={e => updatePrecificacao(veiculo, "preco", e.target.value)} />
                </Field>
                <Field label="Tipo de precificação">
                  <SelectInput value={precificacao[veiculo].tipo} onChange={e => updatePrecificacao(veiculo, "tipo", e.target.value)} options={TIPOS_PRECIFICACAO} placeholder="Padrão" />
                </Field>
                <Field label="Tabela de precificação">
                  <IdSelectInput value={precificacao[veiculo].tabela} onChange={e => updatePrecificacao(veiculo, "tabela", e.target.value)} items={tabelasKm} placeholder="Sem tabela específica" />
                </Field>
              </div>
            </div>
          ))}
        </div>
      </div>

      <div className="mb-8 max-w-md">
        <h2 className="text-sm font-semibold mb-1" style={{ color: C.text, ...fontHead }}>Tabela de comissão do entregador</h2>
        <p className="text-xs mb-3" style={{ color: C.muted, ...fontBody }}>
          Define qual tabela de comissão o entregador recebe ao entregar para este comércio.
        </p>
        <IdSelectInput value={form.tabelaComissao} onChange={e => updateForm("tabelaComissao", e.target.value)} items={tabelasComissaoOpcoes} placeholder="Sem tabela de comissão" />
      </div>

      <div className="mb-8 grid grid-cols-2 gap-4 max-w-3xl">
        <Field label="Cadastro via">
          <SelectInput value={form.cadastroVia} onChange={e => updateForm("cadastroVia", e.target.value)} options={CADASTRO_VIA_OPCOES} />
        </Field>
        <Field label="Tipo de documento">
          <div className="flex gap-1.5">
            {["CPF", "CNPJ"].map(t => (
              <button
