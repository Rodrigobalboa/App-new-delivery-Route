              >
                {t}
              </button>
            ))}
          </div>
        </Field>
        <Field label={tipoDocumento}>
          <TextInput placeholder={tipoDocumento === "CNPJ" ? "00.000.000/0000-00" : "000.000.000-00"} value={form.documento} onChange={e => updateForm("documento", e.target.value)} />
        </Field>
        <Field label="Franquias">
          <SelectInput value={form.franquias} onChange={e => updateForm("franquias", e.target.value)} options={franquiasApi.map(f => f.nome)} placeholder="Nenhuma" />
        </Field>
        <Field label="Hubs">
          <SelectInput value={form.hubs} onChange={e => updateForm("hubs", e.target.value)} options={hubsApi.map(h => h.nome)} placeholder="Nenhum" />
        </Field>
        <Field label="Lead cadastrado por">
          <TextInput placeholder="Nome do responsável comercial" value={form.leadPor} onChange={e => updateForm("leadPor", e.target.value)} />
        </Field>
      </div>

      <div className="mb-8 grid grid-cols-2 gap-4 max-w-3xl">
        <Field label="Nome completo">
          <TextInput placeholder="Nome do responsável" value={form.nomeCompleto} onChange={e => updateForm("nomeCompleto", e.target.value)} />
        </Field>
        <Field label="CNPJ ou CPF" helper="Informe o CNPJ ou CPF do comércio ou pessoa">
          <TextInput placeholder="Documento" value={form.documento} onChange={e => updateForm("documento", e.target.value)} />
        </Field>
        <Field label="Data de nascimento">
          <TextInput type="date" value={form.dataNascimento} onChange={e => updateForm("dataNascimento", e.target.value)} />
        </Field>
        <Field label="Telefone / WhatsApp">
          <TextInput placeholder="(11) 90000-0000" value={form.telefone} onChange={e => updateForm("telefone", e.target.value)} />
        </Field>
        <Field label="E-mail">
          <TextInput type="email" placeholder="contato@comercio.com" value={form.email} onChange={e => updateForm("email", e.target.value)} />
        </Field>
        <Field label="Senha">
          <TextInput type="password" placeholder="••••••••" value={form.senha} onChange={e => updateForm("senha", e.target.value)} />
        </Field>
        <Field label="Método de pagamento preferido">
          <SelectInput value={form.metodoPagamento} onChange={e => updateForm("metodoPagamento", e.target.value)} options={METODOS_PAGAMENTO} />
        </Field>
      </div>

      <div className="mb-8 max-w-3xl">
        <Field label="Observações">
          <textarea
            rows={3}
            placeholder="Informações adicionais sobre o comércio"
            value={form.observacoes}
            onChange={e => updateForm("observacoes", e.target.value)}
            className="w-full px-3 py-2.5 rounded-sm text-sm outline-none resize-none"
            style={{ background: C.panel, border: `1px solid ${C.line}`, color: C.text, ...fontBody }}
          />
        </Field>
      </div>

      <div className="mb-8 max-w-3xl">
        <div className="flex items-center gap-2 mb-3">
          <button
            onClick={() => setMostrarEndereco(!mostrarEndereco)}
            className="flex items-center gap-1.5 px-3.5 py-2 rounded-sm text-xs font-medium"
            style={{ background: C.amber, color: C.ink, ...fontBody }}
          >
            <PlusCircle size={14} /> Adicionar endereço
          </button>
          <button
            onClick={handleAjustarMapa}
            className="flex items-center gap-1.5 px-3.5 py-2 rounded-sm text-xs font-medium"
            style={{ border: `1px solid ${C.line}`, color: C.muted, ...fontBody }}
          >
            <MapPin size={14} /> Ajustar localização no mapa
          </button>
        </div>

        {mostrarEndereco && (
          <div className="rounded-sm p-4 mb-3" style={{ background: C.panel, border: `1px solid ${C.line}` }}>
            <div className="grid grid-cols-3 gap-3 mb-3">
              <TextInput placeholder="Rua" value={enderecoForm.rua} onChange={e => setEnderecoForm({ ...enderecoForm, rua: e.target.value })} />
              <TextInput placeholder="Número" value={enderecoForm.numero} onChange={e => setEnderecoForm({ ...enderecoForm, numero: e.target.value })} />
              <TextInput placeholder="Bairro" value={enderecoForm.bairro} onChange={e => setEnderecoForm({ ...enderecoForm, bairro: e.target.value })} />
              <TextInput placeholder="Cidade" value={enderecoForm.cidade} onChange={e => setEnderecoForm({ ...enderecoForm, cidade: e.target.value })} />
              <TextInput placeholder="CEP" value={enderecoForm.cep} onChange={e => setEnderecoForm({ ...enderecoForm, cep: e.target.value })} />
            </div>
            <button onClick={handleAdicionarEndereco} className="px-4 py-2 rounded-sm text-xs font-medium" style={{ background: C.amber, color: C.ink, ...fontBody }}>
              Salvar endereço
            </button>
          </div>
        )}

        {enderecos.length > 0 && (
          <div className="flex flex-col gap-2">
            {enderecos.map(end => (
              <div key={end.id} className="flex items-center justify-between px-4 py-2.5 rounded-sm text-sm" style={{ background: C.panel, border: `1px solid ${C.line}`, color: C.text, ...fontBody }}>
                <span className="flex items-center gap-2"><MapPin size={13} style={{ color: C.faint }} /> {end.rua}, {end.numero || "s/n"} — {end.bairro} {end.cidade ? `· ${end.cidade}` : ""}</span>
                <button onClick={() => handleRemoverEndereco(end.id)} style={{ color: C.red }}><X size={14} /></button>
              </div>
            ))}
          </div>
        )}
      </div>

      <button onClick={handleSalvarCliente} disabled={salvando} className="mb-10 px-6 py-2.5 rounded-sm text-sm font-medium" style={{ background: C.amber, color: C.ink, opacity: salvando ? 0.6 : 1, ...fontBody }}>
        {salvando ? "Salvando..." : editingId ? "Salvar alterações" : "Salvar cliente"}
      </button>

      <div className="mb-10 max-w-2xl rounded-sm p-4" style={{ background: C.panel, border: `1px solid ${C.line}` }}>
        <div className="flex items-center gap-2 mb-1">
          <UserPlus size={14} style={{ color: C.amber }} />
          <h2 className="text-sm font-semibold" style={{ color: C.text, ...fontHead }}>Usuários adicionais do comércio</h2>
        </div>
        <p className="text-xs mb-4" style={{ color: C.faint, ...fontBody }}>Esses usuários serão criados após salvar o comércio.</p>

        {usuariosAdicionais.length === 0 ? (
          <p className="text-sm mb-4" style={{ color: C.faint, ...fontBody }}>Nenhum usuário adicional.</p>
        ) : (
          <div className="flex flex-col gap-2 mb-4">
            {usuariosAdicionais.map(u => (
              <div key={u.id} className="flex items-center justify-between px-3 py-2 rounded-sm text-sm" style={{ background: C.panelAlt, color: C.text, ...fontBody }}>
                <span>{u.email}</span>
                <button onClick={() => handleRemoverUsuario(u.id)} style={{ color: C.red }}><X size={14} /></button>
              </div>
            ))}
          </div>
        )}

        <div className="grid grid-cols-2 gap-3 mb-3">
          <TextInput type="email" placeholder="E-mail do usuário" value={usuarioForm.email} onChange={e => setUsuarioForm({ ...usuarioForm, email: e.target.value })} />
          <TextInput type="password" placeholder="Senha" value={usuarioForm.senha} onChange={e => setUsuarioForm({ ...usuarioForm, senha: e.target.value })} />
        </div>
        <button onClick={handleAdicionarUsuario} className="px-4 py-2 rounded-sm text-xs font-medium" style={{ border: `1px solid ${C.amber}`, color: C.amber, ...fontBody }}>
          + Adicionar usuário
        </button>
      </div>

      <div>
        <h2 className="text-sm font-semibold mb-3" style={{ color: C.text, ...fontHead }}>Comércios cadastrados</h2>
        <div className="rounded-sm overflow-hidden" style={{ border: `1px solid ${C.line}` }}>
          <table className="w-full text-sm">
            <thead>
              <tr style={{ background: C.panelAlt }}>
                {["Nome", "Segmento", "Telefone", "Endereço"].map(h => (
                  <th key={h} className="text-left px-4 py-2.5 text-xs font-medium" style={{ color: C.faint, ...fontBody }}>{h}</th>
                ))}
                <th className="text-right px-4 py-2.5 text-xs font-medium" style={{ color: C.faint, ...fontBody }}>Ações</th>
              </tr>
            </thead>
            <tbody>
              {comercios.map((c, i) => (
                <tr key={c.id} style={{ background: C.panel, borderTop: i > 0 ? `1px solid ${C.line}` : "none" }}>
                  <td className="px-4 py-3 font-medium" style={{ color: C.text, ...fontBody }}>{c.nome}</td>
                  <td className="px-4 py-3" style={{ color: C.muted, ...fontBody }}>{c.segmento}</td>
                  <td className="px-4 py-3" style={{ color: C.muted, ...fontBody }}>{c.telefone}</td>
                  <td className="px-4 py-3" style={{ color: C.muted, ...fontBody }}>{c.endereco}</td>
                  <td className="px-4 py-3 text-right whitespace-nowrap">
                    <button onClick={() => handleEditar(c)} className="text-xs font-medium mr-4" style={{ color: C.blue }}>Editar</button>
                    <button onClick={() => handleExcluir(c.id)} className="text-xs font-medium" style={{ color: C.red }}>Excluir</button>
                  </td>
                </tr>
              ))}
              {comercios.length === 0 && (
                <tr style={{ background: C.panel }}>
                  <td colSpan={5} className="px-4 py-8 text-center text-sm" style={{ color: C.faint, ...fontBody }}>
                    {carregando ? "Carregando comércios..." : "Nenhum comércio cadastrado ainda."}
                  </td>
                </tr>
              )}
            </tbody>
          </table>
        </div>
      </div>
    </div>
  );
}

// ---------- Entregadores: cadastro completo + importação CSV ----------

const TIPOS_VEICULO = ["Moto", "Bike", "Carro"];
const TIPOS_ENTREGA_ENTREGADOR = ["Próprio", "Terceirizado", "Parceiro"];
const STATUS_ENTREGADOR = ["Em análise", "Ativo", "Inativo"];
const CSV_HEADER = "nome_completo, cpf, rg, data_nascimento, telefone, email, cep, rua, numero, complemento, bairro, cidade, veiculo_tipo, veiculo_modelo, veiculo_placa, veiculo_ano, cnh_valida, tipo_entrega, taxa_entrega, status";

const VEICULO_MAP = { "Moto": "MOTO", "Bike": "BIKE", "Carro": "CARRO" };
