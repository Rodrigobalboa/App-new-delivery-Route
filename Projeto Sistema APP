function MapaTempoReal() {
  const mapRef = useRef(null);
  const mapInstance = useRef(null);
  const markersRef = useRef({});
  const [pronto, setPronto] = useState(false);
  const [pedidos, setPedidos] = useState(() => RASTREIO_PEDIDOS.map(p => ({ ...p })));
  const [selecionado, setSelecionado] = useState(null);

  // Carrega o Leaflet (JS + CSS) via CDN e inicializa o mapa uma única vez
  useEffect(() => {
    let cancelado = false;

    function iniciarMapa() {
      if (cancelado || !mapRef.current || mapInstance.current || !window.L) return;
      const L = window.L;
      const map = L.map(mapRef.current, { zoomControl: true, attributionControl: true }).setView([-23.575, -46.63], 12);
      L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", {
        attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>',
        maxZoom: 19,
      }).addTo(map);
      mapInstance.current = map;
      setPronto(true);
    }

    if (window.L) {
      iniciarMapa();
    } else {
      if (!document.querySelector('link[data-leaflet-css]')) {
        const link = document.createElement("link");
        link.rel = "stylesheet";
        link.href = "https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.css";
        link.setAttribute("data-leaflet-css", "true");
        document.head.appendChild(link);
      }
      let script = document.querySelector('script[data-leaflet-js]');
      if (!script) {
        script = document.createElement("script");
        script.src = "https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.js";
        script.setAttribute("data-leaflet-js", "true");
        document.body.appendChild(script);
      }
      script.addEventListener("load", iniciarMapa);
      if (window.L) iniciarMapa();
    }

    return () => {
      cancelado = true;
      if (mapInstance.current) {
        mapInstance.current.remove();
        mapInstance.current = null;
      }
    };
  }, []);

  // Cria / atualiza os marcadores no mapa
  useEffect(() => {
    if (!pronto || !window.L || !mapInstance.current) return;
    const L = window.L;
    const map = mapInstance.current;

    pedidos.forEach(p => {
      const lat = p.comercio.lat + (p.destino.lat - p.comercio.lat) * p.progresso;
      const lng = p.comercio.lng + (p.destino.lng - p.comercio.lng) * p.progresso;
      const cor = p.status === "a_caminho" ? "#5B8DEF" : "#F2A63A";
      const iconeEntregador = L.divIcon({
        className: "",
        html: `<div style="width:16px;height:16px;background:${cor};border:2px solid #14181F;border-radius:50%;box-shadow:0 0 0 4px ${cor}33;"></div>`,
        iconSize: [16, 16],
        iconAnchor: [8, 8],
      });

      if (!markersRef.current[p.id]) {
        const iconeComercio = L.divIcon({
          className: "",
          html: `<div style="width:14px;height:14px;background:#212837;border:1px solid #5B6478;border-radius:3px;"></div>`,
          iconSize: [14, 14],
          iconAnchor: [7, 7],
        });
        const iconeDestino = L.divIcon({
          className: "",
          html: `<div style="width:14px;height:14px;border:2px solid #5B6478;border-radius:50%;background:transparent;"></div>`,
          iconSize: [14, 14],
          iconAnchor: [7, 7],
        });

        L.marker([p.comercio.lat, p.comercio.lng], { icon: iconeComercio }).addTo(map)
          .bindPopup(`<b>${p.comercio.nome}</b><br/>Comércio de origem`);
        L.marker([p.destino.lat, p.destino.lng], { icon: iconeDestino }).addTo(map)
          .bindPopup(`<b>${p.cliente}</b><br/>${p.destino.endereco}`);
        L.polyline(
          [[p.comercio.lat, p.comercio.lng], [p.destino.lat, p.destino.lng]],
          { color: "#5B6478", weight: 1.5, dashArray: "4 6", opacity: 0.6 }
        ).addTo(map);

        const marcadorEntregador = L.marker([lat, lng], { icon: iconeEntregador }).addTo(map);
        marcadorEntregador.on("click", () => setSelecionado(p));
        markersRef.current[p.id] = marcadorEntregador;
      } else {
        markersRef.current[p.id].setLatLng([lat, lng]);
        markersRef.current[p.id].setIcon(iconeEntregador);
      }
    });
  }, [pronto, pedidos]);

  // Simula o rastreamento em tempo real: entregadores "a caminho" avançam em direção ao cliente
  useEffect(() => {
    const intervalo = setInterval(() => {
      setPedidos(list => list.map(p => {
        if (p.status !== "a_caminho") return p;
        return { ...p, progresso: Math.min(p.progresso + 0.015, 0.97) };
      }));
    }, 2000);
    return () => clearInterval(intervalo);
  }, []);

  return (
    <div className="mb-5">
      <div className="flex gap-4" style={{ height: 380 }}>
        <div className="flex-1 rounded-sm overflow-hidden relative" style={{ border: `1px solid ${C.line}` }}>
          <div ref={mapRef} style={{ width: "100%", height: "100%", background: C.panel }} />
          {!pronto && (
            <div className="absolute inset-0 flex items-center justify-center text-sm" style={{ color: C.faint, background: C.panel, ...fontBody }}>
              Carregando mapa...
            </div>
          )}
          <div
            className="absolute bottom-3 left-3 flex gap-4 px-3 py-2 rounded-sm text-xs"
            style={{ background: C.panelAlt, border: `1px solid ${C.line}`, zIndex: 1000, ...fontBody }}
          >
            <span className="flex items-center gap-1.5" style={{ color: C.muted }}>
              <span className="h-2 w-2 rounded-full" style={{ background: C.amber }} /> No comércio
            </span>
            <span className="flex items-center gap-1.5" style={{ color: C.muted }}>
              <span className="h-2 w-2 rounded-full" style={{ background: C.blue }} /> A caminho do cliente
            </span>
          </div>
        </div>

        <div className="w-72 shrink-0 rounded-sm p-4" style={{ background: C.panel, border: `1px solid ${C.line}` }}>
          {selecionado ? (
            <>
              <div className="flex items-center justify-between mb-4">
                <span className="text-sm font-semibold" style={{ color: C.text, ...fontHead }}>{selecionado.id}</span>
                <span
                  className="text-xs font-medium px-2 py-1 rounded-sm"
                  style={{
                    color: selecionado.status === "a_caminho" ? C.blue : C.amber,
                    background: selecionado.status === "a_caminho" ? "#1D2A45" : C.amberDim,
                    ...fontBody,
                  }}
                >
                  {selecionado.status === "a_caminho" ? "A caminho do cliente" : "No comércio"}
                </span>
              </div>
              <div className="flex flex-col gap-3 text-sm" style={{ ...fontBody }}>
                <div><span className="block text-xs mb-0.5" style={{ color: C.faint }}>Cliente</span><span style={{ color: C.text }}>{selecionado.cliente}</span></div>
                <div><span className="block text-xs mb-0.5" style={{ color: C.faint }}>Entregador</span><span style={{ color: C.text }}>{selecionado.entregador}</span></div>
                <div><span className="block text-xs mb-0.5" style={{ color: C.faint }}>Comércio de origem</span><span style={{ color: C.text }}>{selecionado.comercio.nome}</span></div>
                <div>
                  <span className="block text-xs mb-0.5" style={{ color: C.faint }}>Endereço de entrega</span>
                  <span className="flex items-start gap-1.5" style={{ color: C.text }}>
                    <MapPin size={13} style={{ color: C.faint, marginTop: 2 }} /> {selecionado.destino.endereco}
                  </span>
                </div>
                <div className="flex gap-6 pt-2" style={{ borderTop: `1px solid ${C.line}` }}>
                  <div><span className="block text-xs mb-0.5" style={{ color: C.faint }}>Valor</span><span style={{ color: C.text }}>{selecionado.valor}</span></div>
                  <div><span className="block text-xs mb-0.5" style={{ color: C.faint }}>ETA</span><span style={{ color: C.text }}>{selecionado.eta}</span></div>
                </div>
              </div>
            </>
          ) : (
            <p className="text-sm" style={{ color: C.faint, ...fontBody }}>Clique em um entregador no mapa para ver os detalhes do pedido.</p>
          )}
        </div>
      </div>
      <p className="text-xs mt-2" style={{ color: C.faint, ...fontBody }}>
        Mapa em tempo real (OpenStreetMap via Leaflet). Os entregadores "a caminho" avançam automaticamente em direção ao cliente a cada poucos segundos.
      </p>
    </div>
  );
}

