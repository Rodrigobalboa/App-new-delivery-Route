function emptyFormFor(columns) {
  return Object.fromEntries(columns.map(c => [c.key, c.type === "toggle" ? true : ""]));
}

function CrudTable({ title, description, columns, initialData, idPrefix, apiResource }) {
  const { token } = useAuth();
  const [items, setItems] = useState(initialData || []);
  const [form, setForm] = useState(() => emptyFormFor(columns));
  const [editingId, setEditingId] = useState(null);
  const [feedback, setFeedback] = useState("");
  const [carregando, setCarregando] = useState(!!apiResource);

  const showFeedback = (msg) => {
    setFeedback(msg);
    setTimeout(() => setFeedback(""), 2200);
  };

  useEffect(() => {
    if (!apiResource) return;
    let ativo = true;
    setCarregando(true);
    apiFetch(`/cadastro/${apiResource}`, { token })
      .then(data => { if (ativo) setItems(data || []); })
      .catch(err => showFeedback(`Não foi possível carregar da API: ${err.message}`))
      .finally(() => { if (ativo) setCarregando(false); });
    return () => { ativo = false; };
  }, [apiResource]);

  const handleSubmit = async () => {
    const obrigatorio = columns.find(c => c.required !== false && c.type !== "toggle");
    if (obrigatorio && !String(form[obrigatorio.key] || "").trim()) {
      showFeedback(`Preencha o campo "${obrigatorio.label}".`);
      return;
    }

    if (apiResource) {
      try {
        if (editingId) {
          const atualizado = await apiFetch(`/cadastro/${apiResource}/${editingId}`, { token, method: "PUT", body: form });
          setItems(items.map(it => (it.id === editingId ? atualizado : it)));
          showFeedback("Registro atualizado com sucesso.");
        } else {
          const criado = await apiFetch(`/cadastro/${apiResource}`, { token, method: "POST", body: form });
          setItems([...items, criado]);
          showFeedback("Registro adicionado com sucesso.");
        }
        setEditingId(null);
        setForm(emptyFormFor(columns));
      } catch (err) {
        showFeedback(`Erro ao salvar: ${err.message}`);
      }
      return;
    }

    // Fallback sem API (modo local, usado se nenhum apiResource for informado)
    if (editingId) {
      setItems(items.map(it => (it.id === editingId ? { ...form, id: editingId } : it)));
      showFeedback("Registro atualizado com sucesso.");
      setEditingId(null);
    } else {
      setItems([...items, { ...form, id: `${idPrefix}-${Date.now()}` }]);
      showFeedback("Registro adicionado com sucesso.");
    }
    setForm(emptyFormFor(columns));
  };

  const handleEdit = (item) => {
    setForm(item);
    setEditingId(item.id);
  };

  const handleCancel = () => {
    setEditingId(null);
    setForm(emptyFormFor(columns));
  };

  const handleDelete = async (id) => {
    if (apiResource) {
      try {
        await apiFetch(`/cadastro/${apiResource}/${id}`, { token, method: "DELETE" });
        setItems(items.filter(it => it.id !== id));
        if (editingId === id) handleCancel();
        showFeedback("Registro removido.");
      } catch (err) {
        showFeedback(`Erro ao remover: ${err.message}`);
      }
      return;
    }
    setItems(items.filter(it => it.id !== id));
    if (editingId === id) handleCancel();
    showFeedback("Registro removido.");
  };

  return (
    <div>
      <SectionHeader title={title} subtitle={description} />

      {carregando && (
        <div className="flex items-center gap-2 rounded-sm px-4 py-2.5 mb-4 text-sm" style={{ background: C.panel, color: C.faint, ...fontBody }}>
          Carregando dados da API...
        </div>
      )}

      {feedback && (
        <div className="flex items-center gap-2 rounded-sm px-4 py-2.5 mb-4 text-sm" style={{ background: C.greenDim, color: C.green, ...fontBody }}>
          <CheckCircle2 size={14} /> {feedback}
        </div>
      )}

      <div className="grid gap-3 mb-4" style={{ gridTemplateColumns: `repeat(${columns.length}, minmax(0,1fr)) auto` }}>
        {columns.map(col => (
          <div key={col.key}>
            <label className="block text-xs font-medium mb-1.5" style={{ color: C.muted, ...fontBody }}>{col.label}</label>
            {col.type === "select" ? (
              <div className="relative">
                <select
                  value={form[col.key] ?? ""}
                  onChange={e => setForm({ ...form, [col.key]: e.target.value })}
                  className="w-full px-3 py-2.5 rounded-sm text-sm outline-none appearance-none"
                  style={{ background: C.panel, border: `1px solid ${C.line}`, color: C.text, ...fontBody }}
                >
                  <option value="">Selecionar</option>
                  {col.options.map(o => <option key={o} value={o}>{o}</option>)}
                </select>
                <ChevronDown size={14} className="absolute right-3 top-3 pointer-events-none" style={{ color: C.faint }} />
              </div>
            ) : col.type === "toggle" ? (
              <button
                onClick={() => setForm({ ...form, [col.key]: !form[col.key] })}
                className="w-11 h-7 rounded-full relative mt-1"
                style={{ background: form[col.key] ? C.amber : C.line }}
              >
                <span className="absolute top-0.5 h-6 w-6 rounded-full transition-all" style={{ background: C.ink, left: form[col.key] ? 18 : 2 }} />
              </button>
            ) : (
              <input
                value={form[col.key] ?? ""}
                onChange={e => setForm({ ...form, [col.key]: e.target.value })}
                placeholder={col.placeholder || ""}
                className="w-full px-3 py-2.5 rounded-sm text-sm outline-none"
                style={{ background: C.panel, border: `1px solid ${C.line}`, color: C.text, ...fontBody }}
              />
            )}
          </div>
        ))}
        <div className="flex items-end gap-2">
          <button onClick={handleSubmit} className="px-4 py-2.5 rounded-sm text-sm font-medium whitespace-nowrap" style={{ background: C.amber, color: C.ink, ...fontBody }}>
            {editingId ? "Salvar" : "Adicionar"}
          </button>
          {editingId && (
            <button onClick={handleCancel} className="px-3 py-2.5 rounded-sm text-sm" style={{ border: `1px solid ${C.line}`, color: C.muted, ...fontBody }}>
              <X size={14} />
            </button>
          )}
        </div>
      </div>

      <div className="rounded-sm overflow-hidden" style={{ border: `1px solid ${C.line}` }}>
        <table className="w-full text-sm">
          <thead>
            <tr style={{ background: C.panelAlt }}>
              {columns.map(c => (
                <th key={c.key} className="text-left px-4 py-2.5 text-xs font-medium" style={{ color: C.faint, ...fontBody }}>{c.label}</th>
              ))}
              <th className="text-right px-4 py-2.5 text-xs font-medium" style={{ color: C.faint, ...fontBody }}>Ações</th>
            </tr>
          </thead>
          <tbody>
            {items.map((item, i) => (
              <tr key={item.id} style={{ background: C.panel, borderTop: i > 0 ? `1px solid ${C.line}` : "none" }}>
                {columns.map(c => (
                  <td key={c.key} className="px-4 py-3" style={{ color: C.text, ...fontBody }}>
                    {c.type === "toggle" ? (
                      <span style={{ color: item[c.key] ? C.green : C.faint }}>{item[c.key] ? "Ativo" : "Inativo"}</span>
                    ) : (
                      item[c.key]
                    )}
                  </td>
                ))}
                <td className="px-4 py-3 text-right whitespace-nowrap">
                  <button onClick={() => handleEdit(item)} className="text-xs font-medium mr-4" style={{ color: C.blue }}>Editar</button>
                  <button onClick={() => handleDelete(item.id)} className="text-xs font-medium" style={{ color: C.red }}>Excluir</button>
                </td>
              </tr>
            ))}
            {items.length === 0 && (
              <tr style={{ background: C.panel }}>
                <td colSpan={columns.length + 1} className="px-4 py-8 text-center text-sm" style={{ color: C.faint, ...fontBody }}>
                  Nenhum registro cadastrado ainda.
                </td>
              </tr>
            )}
          </tbody>
        </table>
      </div>
    </div>
  );
}

