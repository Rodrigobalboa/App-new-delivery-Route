function NotificacoesView() {
  const iconFor = (tipo) => ({
    atraso: { Icon: AlertTriangle, color: C.red },
    entrega: { Icon: CheckCircle2, color: C.green },
    financeiro: { Icon: Wallet, color: C.amber },
    mensagem: { Icon: MessageSquare, color: C.blue },
    cadastro: { Icon: Users, color: C.muted },
  }[tipo]);
  return (
    <div>
      <SectionHeader title="Notificações" subtitle="Últimos eventos da operação" />
      <div className="rounded-sm overflow-hidden" style={{ border: `1px solid ${C.line}` }}>
        {NOTIFICACOES.map((n, i) => {
          const { Icon, color } = iconFor(n.tipo);
          return (
            <div key={i} className="flex items-start gap-3 px-4 py-3.5" style={{ background: C.panel, borderTop: i > 0 ? `1px solid ${C.line}` : "none" }}>
              <Icon size={16} style={{ color, marginTop: 2 }} />
              <div className="flex-1">
                <p className="text-sm" style={{ color: C.text, ...fontBody }}>{n.texto}</p>
                <span className="text-xs" style={{ color: C.faint, ...fontBody }}>{n.hora}</span>
              </div>
            </div>
          );
        })}
      </div>
    </div>
  );
}

function ConfiguracoesView() {
  const [toggles, setToggles] = useState({
    push: true, email: true, sms: false, autoAtribuir: true, raio: "8",
  });
  const Toggle = ({ label, desc, checked, onChange }) => (
    <div className="flex items-center justify-between py-3.5" style={{ borderBottom: `1px solid ${C.line}` }}>
      <div>
        <p className="text-sm font-medium" style={{ color: C.text, ...fontBody }}>{label}</p>
        {desc && <p className="text-xs mt-0.5" style={{ color: C.muted, ...fontBody }}>{desc}</p>}
      </div>
      <button
        onClick={onChange}
        className="w-10 h-6 rounded-full relative shrink-0"
        style={{ background: checked ? C.amber : C.line }}
      >
        <span className="absolute top-0.5 h-5 w-5 rounded-full transition-all" style={{ background: C.ink, left: checked ? 18 : 2 }} />
      </button>
    </div>
  );
  return (
    <div className="max-w-xl">
      <SectionHeader title="Configurações" subtitle="Preferências de notificação e operação" />
      <div className="rounded-sm px-4" style={{ background: C.panel, border: `1px solid ${C.line}` }}>
        <Toggle label="Notificações push" desc="Alertas em tempo real de novos pedidos e atrasos" checked={toggles.push} onChange={() => setToggles(t => ({ ...t, push: !t.push }))} />
        <Toggle label="Notificações por e-mail" desc="Resumo diário enviado às 20h" checked={toggles.email} onChange={() => setToggles(t => ({ ...t, email: !t.email }))} />
        <Toggle label="Notificações por SMS" desc="Apenas para atrasos críticos" checked={toggles.sms} onChange={() => setToggles(t => ({ ...t, sms: !t.sms }))} />
        <Toggle label="Atribuição automática de entregador" desc="Distribui pedidos com base na proximidade" checked={toggles.autoAtribuir} onChange={() => setToggles(t => ({ ...t, autoAtribuir: !t.autoAtribuir }))} />
      </div>
      <div className="mt-4 rounded-sm p-4" style={{ background: C.panel, border: `1px solid ${C.line}` }}>
        <label className="block text-xs font-medium mb-1.5" style={{ color: C.muted, ...fontBody }}>Raio máximo de entrega (km)</label>
        <input
          value={toggles.raio}
          onChange={e => setToggles(t => ({ ...t, raio: e.target.value }))}
          className="w-24 px-3 py-2 rounded-sm text-sm outline-none"
          style={{ background: C.panelAlt, border: `1px solid ${C.line}`, color: C.text, ...fontBody }}
        />
      </div>
    </div>
  );
}

export default function App() {
  const [ativo, setAtivo] = useState("pedidos");
  const [token, setToken] = useState(null);
  const [conta, setConta] = useState(null);

  if (!token) {
    return (
      <LoginScreen
        onLogin={(novoToken, novaConta) => { setToken(novoToken); setConta(novaConta); }}
      />
    );
  }

  const handleSair = () => { setToken(null); setConta(null); };

  const render = () => {
    switch (ativo) {
      case "pedidos": return <PedidosView />;
      case "nova": return <NovaEntregaView />;
      case "cadastro": return <CadastroView />;
      case "mensagens": return <MensagensView />;
      case "financeiro": return <FinanceiroView />;
      case "relatorios": return <RelatoriosView />;
      case "notificacoes": return <NotificacoesView />;
      case "config": return <ConfiguracoesView />;
      default: return null;
    }
  };

  return (
    <AuthContext.Provider value={{ token, conta }}>
      <div style={{ background: C.ink, minHeight: "100vh", ...fontBody }}>
        <style>{`
          @import url('https://fonts.googleapis.com/css2?family=Archivo:wght@500;600;700&family=IBM+Plex+Sans:wght@400;500;600&display=swap');
          * { box-sizing: border-box; }
          table { border-collapse: collapse; }
          input::placeholder { color: ${C.faint}; }
        `}</style>

        <div className="flex">
          <aside className="w-60 shrink-0 min-h-screen px-3 py-5 flex flex-col" style={{ background: C.panel, borderRight: `1px solid ${C.line}` }}>
            <div className="px-2 mb-8">
              <div className="flex items-center gap-2">
                <img src={LOGO} alt="Route Delivery" className="h-8 w-8 rounded-sm object-cover" style={{ background: "#000" }} />
                <span className="text-sm font-semibold tracking-tight" style={{ color: C.text, ...fontHead }}>Route Delivery</span>
              </div>
            </div>
            <nav className="flex flex-col gap-0.5 flex-1">
              {NAV.map(item => {
                const Icon = item.icon;
                const isAtivo = ativo === item.id;
                return (
                  <button
                    key={item.id}
                    onClick={() => setAtivo(item.id)}
                    className="flex items-center gap-2.5 px-2.5 py-2 rounded-sm text-left transition-colors"
                    style={{
                      background: isAtivo ? C.amberDim : "transparent",
                      color: isAtivo ? C.amber : C.muted,
                    }}
                  >
                    <Icon size={15} />
                    <span className="text-sm" style={{ ...fontBody }}>{item.label}</span>
                    {isAtivo && <ChevronRight size={13} className="ml-auto" />}
                  </button>
                );
              })}
            </nav>
            <div className="px-2 pt-3" style={{ borderTop: `1px solid ${C.line}` }}>
              {conta && (
                <p className="text-xs mb-2 truncate" style={{ color: C.faint, ...fontBody }}>{conta.nome}</p>
              )}
              <button
                onClick={handleSair}
                className="text-xs font-medium"
                style={{ color: C.muted, ...fontBody }}
              >
                Sair
              </button>
            </div>
          </aside>

          <main className="flex-1 px-8 py-6" style={{ maxWidth: 1180 }}>
            {render()}
          </main>
        </div>
      </div>
    </AuthContext.Provider>
  );
}
