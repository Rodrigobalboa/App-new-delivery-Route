// Endereço do backend (ver pasta /backend). Ajuste se rodar em outra porta/domínio.
const API_BASE_URL = "http://localhost:4000/api";

const AuthContext = createContext(null);

function useAuth() {
  return useContext(AuthContext);
}

/**
 * Wrapper de fetch que já inclui a base da API, o header de autenticação
 * e trata erros/JSON de forma consistente. Lança um Error com a mensagem
 * vinda do backend (campo "erro") quando a resposta não é OK.
 */
async function apiFetch(path, { token, method = "GET", body } = {}) {
  const resp = await fetch(`${API_BASE_URL}${path}`, {
    method,
    headers: {
      "Content-Type": "application/json",
      ...(token ? { Authorization: `Bearer ${token}` } : {}),
    },
    body: body !== undefined ? JSON.stringify(body) : undefined,
  });

  if (resp.status === 204) return null;

  let data = null;
  try { data = await resp.json(); } catch (e) { /* resposta sem corpo */ }

  if (!resp.ok) {
    throw new Error((data && data.erro) || `Erro na requisição (${resp.status}).`);
  }
  return data;
}

function LoginScreen({ onLogin }) {
  const [modo, setModo] = useState("login"); // login | esqueci | redefinir
  const [email, setEmail] = useState("");
  const [senha, setSenha] = useState("");
  const [carregando, setCarregando] = useState(false);
  const [erro, setErro] = useState("");
  const [aviso, setAviso] = useState("");

  const [emailRecuperar, setEmailRecuperar] = useState("");
  const [linkDev, setLinkDev] = useState("");

  const [tokenRedefinir, setTokenRedefinir] = useState("");
  const [novaSenha, setNovaSenha] = useState("");
  const [confirmarSenha, setConfirmarSenha] = useState("");

  const limparMensagens = () => { setErro(""); setAviso(""); };

  const irParaEsqueci = () => {
    limparMensagens();
    setEmailRecuperar(email);
    setLinkDev("");
    setModo("esqueci");
  };

  const irParaLogin = () => {
    limparMensagens();
    setModo("login");
  };

  const handleSubmit = async () => {
    setErro("");
    if (!email.trim() || !senha.trim()) { setErro("Informe e-mail e senha."); return; }
    setCarregando(true);
    try {
      const data = await apiFetch("/auth/login", { method: "POST", body: { email, senha } });
      onLogin(data.token, data.conta);
    } catch (err) {
      setErro(err.message || "Não foi possível fazer login. Verifique se o backend está rodando.");
    } finally {
      setCarregando(false);
    }
  };

  const handleSolicitarRecuperacao = async () => {
    limparMensagens();
    if (!emailRecuperar.trim()) { setErro("Informe o e-mail da conta."); return; }
    setCarregando(true);
    try {
      const data = await apiFetch("/auth/esqueci-senha", { method: "POST", body: { email: emailRecuperar } });
      setAviso(data.mensagem || "Se esse e-mail estiver cadastrado, enviamos um link de redefinição.");
      if (data.devToken) {
        setLinkDev(data.devToken);
      }
    } catch (err) {
      setErro(err.message || "Não foi possível solicitar a recuperação. Verifique se o backend está rodando.");
    } finally {
      setCarregando(false);
    }
  };

  const usarTokenDev = () => {
    limparMensagens();
    setTokenRedefinir(linkDev);
    setModo("redefinir");
  };

  const handleRedefinirSenha = async () => {
    limparMensagens();
    if (!tokenRedefinir.trim()) { setErro('Cole o token/link recebido em "Token de redefinição".'); return; }
    if (novaSenha.length < 8) { setErro("A nova senha precisa ter pelo menos 8 caracteres."); return; }
    if (novaSenha !== confirmarSenha) { setErro("As senhas não coincidem."); return; }
    setCarregando(true);
    try {
      const data = await apiFetch("/auth/redefinir-senha", { method: "POST", body: { token: tokenRedefinir.trim(), novaSenha } });
      setModo("login");
      setSenha("");
      setAviso(data.mensagem || "Senha redefinida com sucesso. Faça login com a nova senha.");
    } catch (err) {
      setErro(err.message || "Não foi possível redefinir a senha.");
    } finally {
      setCarregando(false);
    }
  };

  return (
    <div style={{ background: C.ink, minHeight: "100vh", ...fontBody }} className="flex items-center justify-center px-4">
      <style>{`
        @import url('https://fonts.googleapis.com/css2?family=Archivo:wght@500;600;700&family=IBM+Plex+Sans:wght@400;500;600&display=swap');
        * { box-sizing: border-box; }
      `}</style>
      <div className="w-full max-w-sm rounded-sm p-6" style={{ background: C.panel, border: `1px solid ${C.line}` }}>
        <div className="flex items-center gap-2 mb-6">
          <div className="h-6 w-6 rounded-sm flex items-center justify-center" style={{ background: C.amber }}>
            <Truck size={14} style={{ color: C.ink }} />
          </div>
          <span className="text-sm font-semibold tracking-tight" style={{ color: C.text, ...fontHead }}>Route Delivery</span>
        </div>

        {modo === "login" && (
          <>
            <h1 className="text-lg font-semibold mb-1" style={{ color: C.text, ...fontHead }}>Entrar no painel</h1>
            <p className="text-xs mb-5" style={{ color: C.muted, ...fontBody }}>
              Use a conta gerencial cadastrada no backend (veja o script de seed).
            </p>

            {erro && (
              <div className="rounded-sm px-3 py-2.5 mb-4 text-xs" style={{ background: C.redDim, color: C.red, ...fontBody }}>{erro}</div>
            )}
            {aviso && (
              <div className="rounded-sm px-3 py-2.5 mb-4 text-xs" style={{ background: C.greenDim, color: C.green, ...fontBody }}>{aviso}</div>
            )}

            <div className="flex flex-col gap-3 mb-2">
              <div>
                <label className="block text-xs font-medium mb-1.5" style={{ color: C.muted, ...fontBody }}>E-mail</label>
                <input
                  type="email"
                  value={email}
                  onChange={e => setEmail(e.target.value)}
                  placeholder="admin@routedelivery.com"
                  className="w-full px-3 py-2.5 rounded-sm text-sm outline-none"
                  style={{ background: C.panelAlt, border: `1px solid ${C.line}`, color: C.text, ...fontBody }}
                />
              </div>
              <div>
                <label className="block text-xs font-medium mb-1.5" style={{ color: C.muted, ...fontBody }}>Senha</label>
                <input
                  type="password"
                  value={senha}
                  onChange={e => setSenha(e.target.value)}
                  onKeyDown={e => e.key === "Enter" && handleSubmit()}
                  placeholder="••••••••"
                  className="w-full px-3 py-2.5 rounded-sm text-sm outline-none"
                  style={{ background: C.panelAlt, border: `1px solid ${C.line}`, color: C.text, ...fontBody }}
                />
              </div>
            </div>

            <button onClick={irParaEsqueci} className="text-xs mb-5" style={{ color: C.amber, ...fontBody }}>
              Esqueci minha senha
            </button>

            <button
              onClick={handleSubmit}
              disabled={carregando}
              className="w-full px-4 py-2.5 rounded-sm text-sm font-medium"
              style={{ background: C.amber, color: C.ink, opacity: carregando ? 0.6 : 1, ...fontBody }}
            >
              {carregando ? "Entrando..." : "Entrar"}
            </button>

            <p className="text-xs mt-4" style={{ color: C.faint, ...fontBody }}>
              Backend não configurado ainda? Veja o README na pasta <code>/backend</code> para subir a API e rodar o seed.
            </p>
          </>
        )}

        {modo === "esqueci" && (
          <>
            <h1 className="text-lg font-semibold mb-1" style={{ color: C.text, ...fontHead }}>Recuperar senha</h1>
            <p className="text-xs mb-5" style={{ color: C.muted, ...fontBody }}>
              Informe o e-mail da conta. Se ele existir, enviamos um link de redefinição.
            </p>

            {erro && (
              <div className="rounded-sm px-3 py-2.5 mb-4 text-xs" style={{ background: C.redDim, color: C.red, ...fontBody }}>{erro}</div>
            )}
            {aviso && (
              <div className="rounded-sm px-3 py-2.5 mb-4 text-xs" style={{ background: C.greenDim, color: C.green, ...fontBody }}>{aviso}</div>
            )}

            <div className="mb-5">
              <label className="block text-xs font-medium mb-1.5" style={{ color: C.muted, ...fontBody }}>E-mail</label>
              <input
                type="email"
                value={emailRecuperar}
                onChange={e => setEmailRecuperar(e.target.value)}
                onKeyDown={e => e.key === "Enter" && handleSolicitarRecuperacao()}
                placeholder="admin@routedelivery.com"
